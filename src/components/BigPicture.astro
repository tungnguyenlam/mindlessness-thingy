---
// Where this note fits, under its title: the whole system as a strip of parts with this note's
// part marked "you are here" (a system note lights every part its ideas change), the other ideas
// for the same part, and the reading chain: what to read before, and what builds on this.
// restorable: none, it is static links.
import { PIPELINES, PLACES, placeOf } from '../lib/bigpicture.mjs';
import type { Graph, Note } from '../lib/graph';
import { noteUrl } from '../lib/url';

interface Props {
  note: Note;
  g: Graph;
}
const { note, g } = Astro.props;
const slug = note.id;
const d = note.data;

type Place = { pipe: string; at: string; short: string; role: string };
const here = placeOf(slug, d.kind) as Place | null;

// A system lights the parts of every idea it links to, in the pipeline most of them share.
const used = new Map<string, { slug: string; short: string }[]>();
let pipe = here?.pipe ?? null;
if (d.kind === 'system' && !here) {
  const linked = [...new Set(g.edges.filter((e) => e.from === slug).map((e) => e.to))]
    .map((s) => ({ slug: s, place: placeOf(s, g.notes.get(s)?.data.kind) as Place | null }))
    .filter((x) => x.place && g.notes.get(x.slug)?.data.kind === 'concept');
  const votes = new Map<string, number>();
  for (const x of linked) votes.set(x.place!.pipe, (votes.get(x.place!.pipe) ?? 0) + 1);
  pipe = [...votes].sort((a, b) => b[1] - a[1])[0]?.[0] ?? null;
  for (const x of linked.filter((x) => x.place!.pipe === pipe)) {
    const list = used.get(x.place!.at) ?? [];
    list.push({ slug: x.slug, short: x.place!.short });
    used.set(x.place!.at, list);
  }
  if (!used.size) pipe = null;
}
const P = pipe ? (PIPELINES as Record<string, { label: string; parts: any[] }>)[pipe] : null;
const siblings = here
  ? Object.entries(PLACES as Record<string, Place>)
      .filter(([s, p]) => s !== slug && p.pipe === here.pipe && p.at === here.at && g.notes.has(s))
      .map(([s, p]) => ({ slug: s, short: p.short }))
  : [];

const before = [...new Set([...d.prerequisites, ...d.builds_on])].map((s) => g.notes.get(s)).filter(Boolean) as Note[];
const after = [...g.notes.values()].filter((n) => n.id !== slug && (n.data.prerequisites.includes(slug) || n.data.builds_on.includes(slug)));
const title = (n: Note) => n.data.title.replace(/\s*\(.*\)$/, '');

const show = P || before.length || after.length;

// The picture. The language model is drawn by hand: the main line is the residual stream, from the
// embedding through an opened-up layer (stacked to suggest L of them) to the output head. Other
// pipelines are a row of boxes. Each part has a box and a path the token dot travels to reach it.
type Box = { id: string; label: string; x: number; y: number; w: number; h: number; path: string; kind?: 'pill' | 'add' | 'group' };
const Y = 66;
const B = 125; // branch row, inside the layer
const LLM: Box[] = [
  { id: 'tok', label: 'Tokenizer', x: 4, y: Y - 14, w: 74, h: 28, path: `M41,${Y}` },
  { id: 'emb', label: 'Embedding', x: 88, y: Y - 14, w: 80, h: 28, path: `M41,${Y} H80` },
  { id: 'layers', label: 'Layer × L', x: 180, y: 22, w: 310, h: 160, path: `M41,${Y} H200`, kind: 'group' },
  { id: 'norm', label: 'Norm', x: 188, y: B - 13, w: 44, h: 26, path: `M41,${Y} H210 V${B - 21}` },
  { id: 'mix', label: 'Token mixer', x: 240, y: B - 13, w: 84, h: 26, path: `M41,${Y} H210 V${B} H234` },
  { id: 'pos', label: 'Position', x: 240, y: 80, w: 84, h: 19, path: `M41,${Y} H230 V90`, kind: 'pill' },
  { id: 'cache', label: 'KV cache', x: 248, y: 152, w: 68, h: 22, path: `M41,${Y} H210 V${B} H282 V146` },
  { id: 'ffn', label: 'FFN or MoE', x: 398, y: B - 13, w: 80, h: 26, path: `M41,${Y} H370 V${B} H392` },
  { id: 'res', label: 'Residual add', x: 327, y: Y - 9, w: 18, h: 18, path: `M41,${Y} H322`, kind: 'add' },
  { id: 'head', label: 'Output head', x: 500, y: Y - 14, w: 88, h: 28, path: `M41,${Y} H494` },
  { id: 'next', label: 'Next token', x: 598, y: Y - 14, w: 84, h: 28, path: `M41,${Y} H592` },
];
const linear = (parts: any[]): Box[] => {
  let x = 8;
  return parts.map((p) => {
    const w = Math.max(56, p.label.length * 7 + 22);
    const b = { id: p.id, label: p.label, x, y: 36, w, h: 30, path: `M20,51 H${Math.max(20, x - 8)}` };
    x += w + 26;
    return b;
  });
};
const boxes: Box[] = P ? (pipe === 'llm' ? LLM : linear(P.parts)) : [];
const VW = pipe === 'llm' ? 688 : boxes.length ? boxes.at(-1)!.x + boxes.at(-1)!.w + 8 : 0;
const VH = pipe === 'llm' ? 214 : 84;
const partsById = new Map<string, any>(P ? P.parts.flatMap((p: any) => (p.parts ? [p, ...p.parts] : [p])).map((p: any) => [p.id, p]) : []);
const hereBox = here ? boxes.find((b) => b.id === here.at) : null;
const lit = new Set([...(here ? [here.at] : []), ...used.keys()]);
const linkOf = (id: string) => {
  const l = partsById.get(id)?.link;
  return l && l !== slug && g.notes.has(l) ? l : null;
};
const hitList = [...used].map(([at, list]) => ({ label: partsById.get(at)?.label ?? at, list }));

---

{
  show && (
    <section class="bigpic ui" aria-label="Where this fits">
      {P && (
        <>
          <p class="bp-head">
            Where this fits in <strong>{P.label}</strong>
          </p>
          <div class="bp-scroll">
            <svg viewBox={`0 0 ${VW} ${VH}`} class:list={['bp-svg', { focus: lit.size }]} style={`--vw:${VW}`} role="img" aria-label={`Where this fits in ${P.label}`}>
              {pipe === 'llm' && (
                <g class="bp-frame">
                  <rect class="bp-stack" x="188" y="14" width="310" height="160" rx="8" />
                  <rect class="bp-stack" x="184" y="18" width="310" height="160" rx="8" />
                </g>
              )}
              {pipe === 'llm' && <path class="bp-loop" d="M640,80 V196 H41 V80" />}
              {pipe === 'llm' && <text class="bp-small" x="340" y="210" text-anchor="middle">fed back in: one new token per step</text>}
              {pipe !== 'llm' && boxes.length > 1 && <path class="bp-line" d={`M20,51 H${VW - 20}`} />}
              {boxes.map((b) => {
                const link = linkOf(b.id);
                const cls = ['bp-box', b.kind ?? 'box', lit.has(b.id) ? 'lit' : '', here?.at === b.id ? 'here' : ''].join(' ');
                const body =
                  b.kind === 'group' ? (
                    <>
                      <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" />
                      <line class="bp-stream" x1={b.x} x2={b.x + b.w} y1={Y} y2={Y} />
                      <path class="bp-wire" d={`M210,${Y} V${B - 13} M232,${B} H240 M324,${B} H336 V${Y + 9} M370,${Y} V${B - 13} M392,${B} H398 M478,${B} H482 V${Y + 9} M282,${B + 13} V152`} />
                      <rect class:list={['bp-mini', { lit: lit.has('norm') }]} x="348" y={B - 13} width="44" height="26" rx="4" />
                      <text class="bp-l" x="370" y={B + 4}>Norm</text>
                      <circle class="bp-add2" cx="482" cy={Y} r="8" />
                      <path class="bp-plus" d={`M478,${Y} h8 M482,${Y - 4} v8`} />
                      <text class="bp-gl" x={b.x + 10} y={b.y + 18}>{b.label}</text>
                      <text class="bp-small" x={b.x + 196} y={Y - 6}>residual stream</text>
                    </>
                  ) : b.kind === 'add' ? (
                    <>
                      <circle cx={b.x + 9} cy={b.y + 9} r="9" />
                      <path class="bp-plus" d={`M${b.x + 4},${b.y + 9} h10 M${b.x + 9},${b.y + 4} v10`} />
                    </>
                  ) : (
                    <>
                      <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.kind === 'pill' ? 9 : 4} />
                      <text class="bp-l" x={b.x + b.w / 2} y={b.y + b.h / 2 + 4}>{b.label}</text>
                    </>
                  );
                return link ? (
                  <a href={noteUrl(link)} data-slug={link} class={cls}>
                    <title>{b.label}</title>
                    {body}
                  </a>
                ) : (
                  <g class={cls}>{body}</g>
                );
              })}
              {pipe === 'llm' && <path class="bp-stream main" d={`M78,${Y} H88 M168,${Y} H180 M490,${Y} H500 M588,${Y} H598`} />}
              {hereBox && <circle class="bp-dot" r="6" style={`offset-path: path('${hereBox.path}')`} />}
            </svg>
          </div>
          {here && (
            <p class="bp-you">
              <strong>You are here:</strong> {partsById.get(here.at)?.label}, {here.role}.
            </p>
          )}
          {hitList.length > 0 && (
            <p class="bp-you">
              <strong>What {note.data.title} changes:</strong>{' '}
              {hitList.map((h, k) => (
                <>
                  {k > 0 && ' · '}
                  {h.label}:{' '}
                  {h.list.map((x, j) => (
                    <>
                      {j > 0 && ', '}
                      <a href={noteUrl(x.slug)} data-slug={x.slug}>{x.short}</a>
                    </>
                  ))}
                </>
              ))}
            </p>
          )}
          {siblings.length > 0 && (
            <p class="bp-sib">
              Other ideas for the same part:{' '}
              {siblings.map((s, k) => (
                <>
                  {k > 0 && ' · '}
                  <a href={noteUrl(s.slug)} data-slug={s.slug}>{s.short}</a>
                </>
              ))}
            </p>
          )}
        </>
      )}
      {(before.length > 0 || after.length > 0) && (
        <p class="bp-chain">
          {before.length > 0 && (
            <span class="bp-side">
              <span class="bp-k">Builds on</span>
              {before.map((n) => <a href={noteUrl(n.id)} data-slug={n.id}>{title(n)}</a>)}
            </span>
          )}
          <span class="bp-this">{title(note)}</span>
          {after.length > 0 && (
            <span class="bp-side">
              <span class="bp-k">Leads to</span>
              {after.map((n) => <a href={noteUrl(n.id)} data-slug={n.id}>{title(n)}</a>)}
            </span>
          )}
        </p>
      )}
    </section>
  )
}

<style>
  .bigpic {
    margin: 0 0 1.6rem;
    padding: 0.8rem 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .bp-head {
    margin: 0 0 0.6rem;
  }
  .bp-head strong {
    color: var(--ink);
    font-weight: 600;
  }
  .bp-scroll {
    overflow-x: auto;
  }
  .bp-svg {
    display: block;
    width: 100%;
    min-width: min(calc(var(--vw) * 0.8px), 40rem);
    height: auto;
    font-family: var(--font-ui);
  }
  .bp-box rect,
  .bp-box circle {
    fill: var(--paper);
    stroke: var(--ink-faint);
    stroke-width: 1.3;
    transition: opacity calc(8 * var(--f)) var(--ease-fade);
  }
  .bp-box.group > rect {
    fill: var(--paper-raised);
    stroke-dasharray: 5 4;
  }
  .bp-stack {
    fill: var(--paper);
    stroke: var(--rule);
  }
  .bp-l {
    font-size: 13px;
    text-anchor: middle;
    fill: var(--ink);
  }
  .bp-gl {
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  .bp-small {
    font-size: 11.5px;
    fill: var(--ink-faint);
  }
  .bp-mini {
    stroke-dasharray: none !important;
    fill: var(--paper);
    stroke: var(--ink-faint);
  }
  .bp-mini.lit {
    fill: var(--role-activation-wash);
    stroke: var(--ink);
    stroke-width: 2.4;
  }
  .bp-stream,
  .bp-line {
    stroke: var(--role-activation);
    stroke-width: 3;
    fill: none;
  }
  .bp-line {
    stroke: var(--ink-faint);
    stroke-width: 1.5;
  }
  .bp-wire {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.2;
  }
  .bp-loop {
    fill: none;
    stroke: var(--ink-faint);
    stroke-dasharray: 4 3;
  }
  .bp-add2 {
    fill: var(--paper);
    stroke: var(--ink-faint);
    stroke-width: 1.3;
  }
  .bp-plus {
    stroke: var(--ink-soft);
    stroke-width: 1.4;
  }
  /* Everything not lit steps back, so the reader's part stands out. */
  .focus .bp-box:not(.lit):not(.group) :is(text, .bp-plus) {
    opacity: 0.55;
  }
  .focus .bp-box:not(.lit):not(.group) :is(rect, circle) {
    stroke: var(--rule);
  }
  .bp-box.lit:not(.group) rect,
  .bp-box.lit:not(.group) circle {
    fill: var(--role-activation-wash);
    stroke: var(--ink);
    stroke-width: 2.4;
  }
  .bp-box.lit.group > rect {
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-dasharray: none;
  }
  .bp-box.lit .bp-l {
    font-weight: 600;
  }
  .bp-box.here:not(.group) {
    animation: bp-here calc(18 * var(--f)) var(--ease-land) calc(30 * var(--f)) both;
    transform-box: fill-box;
    transform-origin: center;
  }
  a.bp-box:hover rect,
  a.bp-box:focus-visible rect {
    stroke: var(--ink);
    stroke-width: 2.4;
  }
  .bp-dot {
    fill: var(--ink);
    stroke: var(--paper-raised);
    stroke-width: 2;
    offset-rotate: 0deg;
    animation: bp-travel calc(30 * var(--f)) var(--ease-glide) calc(4 * var(--f)) both;
  }
  .bp-you {
    margin: 0.5rem 0 0;
    color: var(--ink);
  }
  @keyframes bp-travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  @keyframes bp-here {
    40% {
      transform: scale(1.08);
    }
  }
  .bp-sib {
    margin: 0.6rem 0 0;
  }
  .bp-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule-soft);
  }
  .bp-side {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }
  .bp-k {
    color: var(--ink-faint);
  }
  .bp-this {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-block);
    background: var(--ink);
    color: var(--paper-raised);
    font-weight: 600;
  }
  .bp-this::before {
    content: '→ ';
    font-weight: 400;
  }
  .bp-side + .bp-this::before,
  .bp-this:first-child::before {
    content: '';
  }
  .bp-side:first-child::after {
    content: '→';
    color: var(--ink-faint);
  }
  .bp-this + .bp-side::before {
    content: '→';
    color: var(--ink-faint);
  }
</style>
