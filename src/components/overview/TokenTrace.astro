---
// "Follow a token": the token-level tab of <ModelOverview>. The other tabs draw the architecture
// (layers, projections, weights); this one follows one real token of a sample text through it, one
// stage at a time: text → ids, id → embedding row, which earlier tokens each sublayer reads, the
// arithmetic inside one attention head, what the token leaves in the cache, the FFN or the experts
// it is routed to, and the output head. Everything structural (tokens, ids, sizes, which positions
// are read, cache bytes, parameter counts) comes from the model and tokenizer data. What would need
// the real weights (attention scores, which experts the router picks) is drawn as a labelled example.
//   Rendered by <ModelOverview>; not a note component.
import { parsePattern, DERIVED, formatDerived } from '../../lib/models/data.mjs';
import { samplesFor, SAMPLES } from '../../lib/tokenizers/samples';
import { noteUrl } from '../../lib/url';
import { fmtParams } from '../../lib/models/params.mjs';

interface Props {
  model: any;
  tokenizer: any;
  /** slug → whether a note exists, for links. */
  has: (slug: string) => boolean;
  samples?: string[];
}
const { model: m, tokenizer: tok, has, samples: sampleIds = ['english', 'code'] } = Astro.props;
const v = (k: string): any => m.values[k]?.v ?? m.derived?.[k]?.v;
const num = (k: string): number | null => {
  const x = v(k);
  return typeof x === 'number' && x > 0 ? x : null;
};
const tokId = String(m.values.tokenizer?.v);
const gen = samplesFor(tokId, '<ModelOverview> token tab');
const MAXTOK = 10;
// The begin-of-sequence token, when the tokenizer itself adds it (add_bos starts with "yes").
const bos = /^yes/i.test(String(tok?.add_bos?.v ?? '')) ? tok?.specials?.tokens?.find((s: any) => /begin of seq/i.test(s.use)) : null;
const sets = sampleIds.map((id) => {
  const s = SAMPLES.find((x) => x.id === id)!;
  const chips = gen.samples[id].chips.slice(0, MAXTOK);
  const tokens = chips.map((c) => ({ text: c.text, id: c.ids[0], special: false }));
  return { label: s.label, tokens: bos ? [{ text: bos.token, id: bos.id, special: true }, ...tokens] : tokens };
});

const layers = parsePattern(m.values.layer_pattern.v);
const count = (c: string) => layers.filter((l) => l.includes(c)).length;
const ranges = (c: string) => {
  // "1–3, 5" style list of the layers that hold code c (1-based).
  const out: string[] = [];
  let start = -1;
  layers.forEach((l, i) => {
    const on = l.includes(c);
    if (on && start < 0) start = i;
    if ((!on || i === layers.length - 1) && start >= 0) {
      const end = on ? i : i - 1;
      out.push(start === end ? `${start + 1}` : `${start + 1}–${end + 1}`);
      start = -1;
    }
  });
  return out.length > 4 ? null : out.join(', ');
};
const link = (slug: string) => (has(slug) ? { href: noteUrl(slug), slug } : null);

const d = num('hidden_size')!;
const attnKind = String(v('attention') ?? '');
const topk = num('sparse_topk');
const ATTN_NAME: Record<string, string> = { mla: 'Latent attention (MLA)', gqa: 'Grouped-query attention', mha: 'Multi-head attention', mqa: 'Multi-query attention', dsa: 'Sparse attention' };
const mixers: any[] = [];
if (count('A'))
  mixers.push({
    code: 'A',
    label: `${ATTN_NAME[attnKind] ?? 'Attention'}${topk ? ', sparse' : ''}`,
    reads: topk ? 'topk' : 'all',
    topk,
    layers: count('A'),
    where: ranges('A'),
    link: link(topk ? 'dsa' : attnKind) ?? link('attention'),
  });
if (count('C')) mixers.push({ code: 'C', label: 'Gated short conv', reads: 'window', k: num('conv_window'), layers: count('C'), where: ranges('C'), link: link('gated-short-conv') });
if (count('G')) mixers.push({ code: 'G', label: 'Gated DeltaNet', reads: 'state', layers: count('G'), where: ranges('G'), link: link('gated-deltanet') });
if (count('M')) mixers.push({ code: 'M', label: 'Mamba-2', reads: 'state', layers: count('M'), where: ranges('M'), link: link('mamba-2') });

// Attention head sizes. MLA heads score over the no-RoPE part plus the decoupled RoPE part.
let head: any = null;
if (count('A')) {
  const nh = num('heads');
  const dh = num('head_dim');
  const mla = attnKind === 'mla';
  const dqk = mla && dh && num('rope_head_dim') ? dh + num('rope_head_dim')! : dh;
  const kvh = attnKind === 'mqa' ? 1 : attnKind === 'mha' ? nh : num('kv_heads');
  // A latent KV path (MLA, and DSA built on it) is drawn whenever the data has a KV latent and a RoPE part.
  const latent = !!(num('kv_lora_rank') && num('rope_head_dim') && dh);
  head = {
    kind: attnKind,
    nh,
    kvh: mla ? null : kvh,
    dqk,
    dv: num('v_head_dim') ?? (mla ? null : dh),
    dc: mla ? num('kv_lora_rank') : null,
    dr: mla ? num('rope_head_dim') : null,
    topk,
    link: link(attnKind) ?? link('attention'),
    // For the tensor pictures (overview/tensorpics.ts).
    pic: {
      latent,
      dh,
      dr: latent ? num('rope_head_dim') : null,
      dc: latent ? num('kv_lora_rank') : null,
      dq: num('q_lora_rank'),
      dv: num('v_head_dim') ?? dh,
      kvh: latent ? null : (kvh ?? nh),
    },
  };
}

// What one token leaves behind per layer kind. Attention grows with context; the others are fixed.
const kvDef = DERIVED.find((x) => x.key === 'kv_bytes_per_token')!;
const kvBytes = num('kv_bytes_per_token');
const kvCtx = num('kv_bytes_at_context');
let attnPerLayer: number | null = null;
let attnParts = '';
if (head && head.kind === 'mla' && head.dc && head.dr) {
  attnPerLayer = head.dc + head.dr;
  attnParts = `c<sup>KV</sup> (${head.dc.toLocaleString('en-US')}) + k<sup>R</sup> (${head.dr.toLocaleString('en-US')})`;
} else if (head && head.kvh && head.dqk && ['gqa', 'mha', 'mqa'].includes(head.kind)) {
  attnPerLayer = 2 * head.kvh * head.dqk;
  attnParts = `K and V for ${head.kvh} head${head.kvh > 1 ? 's' : ''} of ${head.dqk}`;
}
const fixed: any[] = [];
if (count('C') && num('conv_window')) fixed.push({ label: 'Gated short conv', layers: count('C'), numbers: num('conv_window')! * d, what: `the last ${num('conv_window')} inputs, ${num('conv_window')} × ${d.toLocaleString('en-US')}` });
if (count('G') && num('linear_v_heads') && num('linear_k_dim') && num('linear_v_dim'))
  fixed.push({ label: 'Gated DeltaNet', layers: count('G'), numbers: num('linear_v_heads')! * num('linear_k_dim')! * num('linear_v_dim')!, what: `a state of ${num('linear_v_heads')} × ${num('linear_k_dim')} × ${num('linear_v_dim')}` });

const ffn: any = {};
if (count('D')) ffn.dense = { layers: count('D'), where: ranges('D'), dff: num('ffn_hidden'), act: v('ffn_activation') ?? null };
if (count('E'))
  ffn.moe = {
    layers: count('E'),
    where: ranges('E'),
    Nr: num('routed_experts'),
    Kr: num('active_experts'),
    Ns: num('shared_experts'),
    de: num('expert_hidden'),
    groups: num('expert_groups'),
    groupsActive: num('expert_groups_active'),
    link: link(v('shared_experts') ? 'deepseek-moe' : 'moe') ?? link('moe'),
  };

const config = JSON.stringify({
  title: m.title,
  sets,
  d,
  V: num('vocab_size'),
  L: layers.length,
  tied: v('tie_embeddings') === true,
  norm: /rmsnorm/i.test(String(v('norm') ?? 'RMSNorm')) ? 'RMSNorm' : 'Norm',
  mixers,
  head,
  cache: {
    attnPerLayer,
    attnParts,
    attnLayers: count('A'),
    bytes: kvBytes,
    bytesText: kvBytes ? formatDerived(kvDef, kvBytes) : null,
    ctxText: kvCtx ? formatDerived(kvDef, kvCtx) : null,
    ctxLen: m.values.context_length?.display ?? (num('context_length') ? num('context_length')!.toLocaleString('en-US') : null),
    sparse: !!topk,
    fixed,
  },
  ffn,
  params: { total: num('params_total') ? fmtParams(num('params_total')) : null, active: num('params_active') && num('params_active')! < (num('params_total') ?? Infinity) ? fmtParams(num('params_active')) : null },
  links: { embedding: link('embedding'), kv: link('kv-cache'), softmax: link('softmax'), tokenizer: tok?.note && has(tok.note) ? { href: noteUrl(tok.note), slug: tok.note } : null },
  tokTitle: tok?.title ?? 'the tokenizer',
  hasBos: !!bos,
});
const STAGES = ['Tokens', 'Embedding', 'Which tokens', ...(head && head.nh && head.pic.dh ? ['Q, K, V', 'Heads', 'Scores', 'Mix values', 'Join heads'] : []), 'Cache', ffn.moe ? 'Experts' : 'FFN', 'Output'];
---

<x-tokentrace class="trace" data-restorable>
  <script type="application/json" set:html={config} />
  <p class="tk-hint">Pick a token, then step through what happens to it. Sizes are {m.title}’s, from its data; values that would need the real weights are marked <span class="tk-ex">example</span>.</p>
  <div class="tk-bar">
    {
      sets.length > 1 && (
        <div class="tk-tabs" role="tablist" aria-label="Sample text">
          {sets.map((s, i) => (
            <button type="button" role="tab" data-set={i} aria-selected={i === 0 ? 'true' : 'false'}>
              {s.label}
            </button>
          ))}
        </div>
      )
    }
  </div>
  <div class="tk-scroll" data-keep-scroll>
    <div class="tk-row" data-out="tokens" role="group" aria-label="Tokens of the sample"></div>
  </div>
  <ol class="tk-stages" role="tablist" aria-label="Stages">
    {
      STAGES.map((s, i) => (
        <li>
          <button type="button" role="tab" data-stage={i} aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="tk-n">{i + 1}</span>
            {s}
          </button>
        </li>
      ))
    }
  </ol>
  <div class="tk-stage" data-out="stage" aria-live="polite"></div>
  <div class="tk-nav">
    <button type="button" data-step="-1">← Back</button>
    <span data-out="pos"></span>
    <button type="button" data-step="1">Next →</button>
  </div>
</x-tokentrace>

<script>
  // Restorable (src/scripts/trail.ts): sample, chosen token and stage come back on return.
  import { Track, figure, legend, tokColor, pure, norm, row, sequence, CELL, type Mix, type Part } from './tensorpics';
  interface Tok { text: string; id: number; special: boolean }
  type Link = { href: string; slug: string } | null;
  const fmt = (x: number) => x.toLocaleString('en-US');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const ws = (t: string) => t.replace(/ /g, '·').replace(/\n/g, '↵').replace(/\t/g, '→');
  // Special tokens are long (<｜begin▁of▁sentence｜>); the chip says what it is, the title has it in full.
  const show = (t: Tok) => (t.special ? `<span title="${esc(t.text)}">BOS</span>` : esc(ws(t.text)));
  const a = (l: Link, text: string) => (l ? `<a href="${l.href}" data-slug="${l.slug}">${text}</a>` : text);
  const bytes = (x: number) => {
    const u = ['B', 'KB', 'MB', 'GB', 'TB'];
    let i = 0;
    while (x >= 1024 && i < u.length - 1) (x /= 1024), i++;
    return `${+x.toPrecision(3)} ${u[i]}`;
  };
  // Deterministic "random" numbers for the example values, so a token always shows the same ones.
  const hash = (...xs: number[]) => {
    let h = 2166136261;
    for (const x of xs) {
      h ^= x | 0;
      h = Math.imul(h, 16777619);
      h ^= h >>> 13;
      h = Math.imul(h, 2246822507);
      h ^= h >>> 16;
    }
    return (h >>> 0) / 4294967296;
  };
  const EX = '<span class="tk-ex">example</span>';

  class XTokenTrace extends HTMLElement {
    st = { set: 0, t: -1, stage: 0 };
    snapshot() {
      return this.st.set || this.st.stage || this.st.t !== this.def ? { ...this.st } : null;
    }
    restore(state: unknown) {
      const s = state as Partial<XTokenTrace['st']>;
      if (s && typeof s === 'object') this.apply({ ...this.st, ...s });
    }
    def = 0;
    apply(_s: XTokenTrace['st']) {}
    connectedCallback() {
      const cfg = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const q = <T extends Element>(sel: string) => this.querySelector<T>(sel)!;
      const stages = [...this.querySelectorAll<HTMLElement>('[data-stage]')].map((b) => b.textContent!.replace(/^\s*\d+/, '').trim());
      this.def = Math.min(4, cfg.sets[0].tokens.length - 1);
      if (this.st.t < 0) this.st.t = this.def;

      // Tensor pictures (./tensorpics.ts): one square-root length scale per model, fitted to its widest vector.
      const P = cfg.head?.pic ?? {};
      const nh: number = cfg.head?.nh ?? 1;
      const maxDim = Math.max(cfg.d, P.dh ? nh * (P.dh + (P.dr ?? 0)) : 0, P.dv ? nh * P.dv : 0);
      const kS = 210 / Math.sqrt(maxDim);
      const Lp = (n: number) => Math.max(10, Math.round(kS * Math.sqrt(n)));
      // One head's vectors, zoomed: the widest of them is drawn 100 px long.
      const kZ = 100 / Math.sqrt(Math.max(P.dh ? P.dh + (P.dr ?? 0) : 1, P.dv ?? 1));
      const Lz = (n: number) => Math.max(10, Math.round(kZ * Math.sqrt(n)));
      const colOf = (toks: Tok[], j: number) => tokColor(j, toks[j].special);
      const short = (x: Tok) => (x.special ? 'BOS' : ws(x.text).slice(0, 4) || '·');
      // Example attention of position t in one head: deterministic per token, position and head.
      const attend = (toks: Tok[], t: number, head: number) => {
        const scores = toks.slice(0, t + 1).map((x, j) => +(hash(toks[t].id, x.id, j, head) * 5 - 1.5).toFixed(1));
        const mx = Math.max(...scores);
        const ex = scores.map((s) => Math.exp(s - mx));
        const sum = ex.reduce((p, q) => p + q, 0);
        return { scores, w: ex.map((x) => x / sum) };
      };
      const blendOf = (toks: Tok[], w: number[]): Mix => norm(w.map((x, j) => ({ c: colOf(toks, j), w: x })));
      const meanW = (all: number[][]) => all[0].map((_, j) => all.reduce((s, w) => s + w[j], 0) / all.length);
      // After the residual add: half the token's own vector, half the attention output (an illustration).
      const residual = (toks: Tok[], t: number, heads: number[][]): Mix => {
        const m = meanW(heads);
        return norm(m.map((x, j) => ({ c: colOf(toks, j), w: 0.5 * x + (j === t ? 0.5 : 0) })));
      };

      const render: Record<string, (toks: Tok[], t: number) => string> = {
        Tokens: (toks, t) => {
          const tk = toks[t];
          const text = toks.filter((x) => !x.special).map((x) => x.text).join('');
          return `
            <div class="tk-flow">
              <span class="tk-box op"><b>Text</b><small>${esc(ws(text))}${toks.length < 12 ? '' : '…'}</small></span>
              <span class="tk-arrow">→</span>
              <span class="tk-box op"><b>${a(cfg.links.tokenizer, esc(cfg.tokTitle))}</b><small>splits, then looks up ids</small></span>
              <span class="tk-arrow">→</span>
              <span class="tk-box act"><b>${toks.length} ids</b><small>one per token above</small></span>
            </div>
            <p class="tk-read">Your token is <code>${show(tk)}</code>, position ${t + 1}, id <b>${fmt(tk.id)}</b>. The model never sees the letters: from here on it only has the number ${fmt(tk.id)}.
            ${tk.special ? ' This one is a special token: the tokenizer adds it in front of every input, it is not part of the text.' : ''}
            ${cfg.hasBos && !tk.special ? ' The first chip is a special token the tokenizer adds in front of every input.' : ''}</p>`;
        },
        Embedding: (toks, t) => {
          const tk = toks[t];
          const V = cfg.V;
          const c = colOf(toks, t);
          // The id as a one-hot row of length V, times the V × d table, is row id: the picture of a lookup.
          const lenV = Math.min(Lp(V), 2 * Lp(cfg.d), 300);
          const at = tk.id / Math.max(1, V - 1);
          const tick = Math.max(3 / lenV, 0.004);
          const pre = Math.max(0, Math.min(1 - tick, at - tick / 2));
          const GREY = '#e6e9ee';
          const tr = new Track();
          tr.vec({ id: 'id', len: lenV, parts: [{ f: pre, mix: pure(GREY) }, { f: tick, mix: pure(c) }, { f: 1 - pre - tick, mix: pure(GREY) }], name: `one-hot id ${fmt(tk.id)}`, size: `${fmt(V)} (drawn shorter)` });
          tr.mul('id', { name: 'Embedding table', sub: `${fmt(V)} × ${fmt(cfg.d)}`, hot: { at, color: c } }, { id: 'h', len: Lp(cfg.d), parts: [{ f: 1, mix: pure(c) }], name: `h_{${t + 1}}`, size: fmt(cfg.d) });
          return `
            ${legend(['vec', 'weight'], c, colOf(toks, Math.max(0, t - 1)))}
            ${figure([tr], `Embedding lookup for ${tk.text}`)}
            <p class="tk-read">The id picks row ${fmt(tk.id)} of the ${a(cfg.links.embedding, 'embedding table')}. Written as a product, the id is a row of ${fmt(V)} zeros with a single 1, and multiplying it by the table keeps only that row, so in practice no arithmetic happens. The row, ${fmt(cfg.d)} learned numbers, is the token’s hidden state h<sub>${t + 1}</sub>.</p>
            <p class="tk-read">From here on, the colour of a bar says whose information it holds. h<sub>${t + 1}</sub> has your token’s colour only: nothing has been mixed in yet. Every token does this on its own, so the ${toks.length} tokens become ${toks.length} bars of ${fmt(cfg.d)}, one per token, each in its own colour.</p>`;
        },
        'Which tokens': (toks, t) => {
          const rows: string[] = [];
          const head = `<div class="tk-gl"></div>${toks.map((x, j) => `<span class="tk-gh${j === t ? ' cur' : ''}${j > t ? ' future' : ''}">${show(x)}</span>`).join('')}`;
          const notes: string[] = [];
          for (const mx of cfg.mixers) {
            const cells = toks
              .map((_, j) => {
                if (j > t) return '<span class="tk-c future"></span>';
                if (j === t) return '<span class="tk-c self">self</span>';
                if (mx.reads === 'all' || (mx.reads === 'topk' && t < mx.topk)) return '<span class="tk-c read">read</span>';
                if (mx.reads === 'window') return j > t - mx.k ? '<span class="tk-c read">read</span>' : '<span class="tk-c no"></span>';
                if (mx.reads === 'state') return '<span class="tk-c state">in S</span>';
                return '<span class="tk-c read">maybe</span>';
              })
              .join('');
            rows.push(`<div class="tk-gl"><b>${a(mx.link, esc(mx.label))}</b><small>${mx.layers} layer${mx.layers > 1 ? 's' : ''}${mx.where ? ` (${mx.where})` : ''}</small></div>${cells}`);
            if (mx.reads === 'all') notes.push(`${esc(mx.label)} reads every earlier token and itself, ${t + 1} positions here, and never the tokens to its right.`);
            if (mx.reads === 'topk') notes.push(`${esc(mx.label)} scores every earlier token with a cheap indexer and reads only the best ${fmt(mx.topk)}. This sample is shorter than that, so here it reads them all; the choice only bites in long contexts.`);
            if (mx.reads === 'window') notes.push(`The ${esc(mx.label.toLowerCase())} reads only the last ${mx.k} positions, itself included, so a far-back token can only reach yours through the attention layers.`);
            if (mx.reads === 'state') notes.push(`${esc(mx.label)} does not look at earlier tokens one by one: they were folded into a fixed-size state S, and your token reads S and then updates it.`);
          }
          const ffnRow = (label: string, l: number, where: string | null) =>
            `<div class="tk-gl"><b>${label}</b><small>${l} layer${l > 1 ? 's' : ''}${where ? ` (${where})` : ''}</small></div>${toks.map((_, j) => (j > t ? '<span class="tk-c future"></span>' : j === t ? '<span class="tk-c self">self</span>' : '<span class="tk-c no"></span>')).join('')}`;
          if (cfg.ffn.dense) rows.push(ffnRow('Dense FFN', cfg.ffn.dense.layers, cfg.ffn.dense.where));
          if (cfg.ffn.moe) rows.push(ffnRow('MoE FFN', cfg.ffn.moe.layers, cfg.ffn.moe.where));
          notes.push(`The FFN sublayers touch your token alone: tokens only exchange information in the mixers.`);
          return `
            <div class="tk-scroll" data-keep-scroll><div class="tk-grid" style="--n:${toks.length}">${head}${rows.join('')}</div></div>
            <p class="tk-read">h<sub>${t + 1}</sub> goes up through all ${cfg.L} layers in order and stays ${fmt(cfg.d)} numbers wide: each sublayer reads a normalized copy and adds its result back. The rows show which positions each kind of sublayer reads when it computes position ${t + 1}.</p>
            <ul class="tk-notes">${notes.map((x) => `<li>${x}</li>`).join('')}</ul>`;
        },
        'Q, K, V': (toks, t) => {
          const own = pure(colOf(toks, t));
          const T1 = t + 1;
          const hBar = (id = 'h') => ({ id, len: Lp(cfg.d), parts: [{ f: 1, mix: own }], name: `h_{${T1}}`, size: `${fmt(cfg.d)}, normalized` });
          const solid = [{ f: 1, mix: own }];
          const rope = [{ f: 1, mix: own, rope: true }];
          const tracks: Track[] = [];
          let text: string;
          if (P.latent) {
            const tq = new Track('Queries');
            tq.vec(hBar());
            let qs = 'h';
            if (P.dq) {
              tq.mul('h', { name: 'W^{DQ}', sub: `${fmt(cfg.d)} → ${fmt(P.dq)}` }, { id: 'cq', len: Lp(P.dq), parts: solid, name: 'c^{Q}', size: fmt(P.dq) });
              qs = 'cq';
            }
            const qin = P.dq ?? cfg.d;
            tq.mul(qs, { name: P.dq ? 'W^{UQ}' : 'W^{Q}', sub: `${fmt(qin)} → ${fmt(nh * P.dh)}` }, { id: 'qc', len: Lp(nh * P.dh), parts: solid, name: 'q^{C}, no position', size: `${fmt(nh * P.dh)} = ${nh} × ${P.dh}` });
            tq.mul(qs, { name: 'W^{QR}', sub: `${fmt(qin)} → ${fmt(nh * P.dr)}` }, { id: 'qr', len: Lp(nh * P.dr), parts: rope, name: 'q^{R}, RoPE', size: `${fmt(nh * P.dr)} = ${nh} × ${P.dr}` });
            const tk = new Track('Keys and values');
            tk.vec(hBar());
            tk.mul('h', { name: 'W^{DKV}', sub: `${fmt(cfg.d)} → ${fmt(P.dc)}` }, { id: 'ckv', len: Lp(P.dc), parts: solid, name: 'c^{KV}', size: fmt(P.dc), cached: true });
            tk.mul('ckv', { name: 'W^{UK}', sub: `${fmt(P.dc)} → ${fmt(nh * P.dh)}` }, { id: 'kc', len: Lp(nh * P.dh), parts: solid, name: 'k^{C}', size: `${fmt(nh * P.dh)} = ${nh} × ${P.dh}` });
            tk.mul('ckv', { name: 'W^{UV}', sub: `${fmt(P.dc)} → ${fmt(nh * P.dv)}` }, { id: 'v', len: Lp(nh * P.dv), parts: solid, name: 'v', size: `${fmt(nh * P.dv)} = ${nh} × ${P.dv}` });
            tk.mul('h', { name: 'W^{KR}', sub: `${fmt(cfg.d)} → ${fmt(P.dr)}` }, { id: 'kr', len: Lp(P.dr), parts: rope, name: 'k^{R}', size: fmt(P.dr), cached: true });
            tracks.push(tq, tk);
            text = `Each matrix is drawn as tall as its input is long and as wide as its output, so you can read every projection as “this bar goes in down the left edge, that bar comes out below”. Queries and keys come in two parts: a large part with no position (q<sup>C</sup>, k<sup>C</sup>) and a small RoPE part rotated by the token’s position (q<sup>R</sup>, k<sup>R</sup>, hatched). Only the small latent c<sup>KV</sup>, ${fmt(P.dc)} numbers, and k<sup>R</sup>, ${fmt(P.dr)}, go into the ${a(cfg.links.kv, 'cache')}; k<sup>C</sup> and v are rebuilt from c<sup>KV</sup> when needed, which is the point of ${a(cfg.head.link, 'latent attention')}.`;
          } else {
            const kvh = P.kvh;
            const tr = new Track();
            tr.vec(hBar());
            let qs = 'h';
            if (P.dq) {
              tr.mul('h', { name: 'W^{DQ}', sub: `${fmt(cfg.d)} → ${fmt(P.dq)}` }, { id: 'cq', len: Lp(P.dq), parts: solid, name: 'c^{Q}', size: fmt(P.dq) });
              qs = 'cq';
            }
            tr.mul(qs, { name: P.dq ? 'W^{UQ}' : 'W^{Q}', sub: `${fmt(P.dq ?? cfg.d)} → ${fmt(nh * P.dh)}` }, { id: 'q', len: Lp(nh * P.dh), parts: solid, name: `q_{${T1}}`, size: `${fmt(nh * P.dh)} = ${nh} × ${P.dh}` });
            tr.mul('h', { name: 'W^{K}', sub: `${fmt(cfg.d)} → ${fmt(kvh * P.dh)}` }, { id: 'k', len: Lp(kvh * P.dh), parts: solid, name: `k_{${T1}}`, size: `${fmt(kvh * P.dh)} = ${kvh} × ${P.dh}`, cached: true });
            tr.mul('h', { name: 'W^{V}', sub: `${fmt(cfg.d)} → ${fmt(kvh * P.dv)}` }, { id: 'v', len: Lp(kvh * P.dv), parts: solid, name: `v_{${T1}}`, size: `${fmt(kvh * P.dv)} = ${kvh} × ${P.dv}`, cached: true });
            tracks.push(tr);
            text = `Each matrix is drawn as tall as its input is long and as wide as its output, so you can read every projection as “this bar goes in down the left edge, that bar comes out below”. ${kvh < nh ? `The key and value bars are shorter than the query because there are only ${kvh} key/value head${kvh > 1 ? 's' : ''} for ${nh} query heads.` : ''} k<sub>${T1}</sub> and v<sub>${T1}</sub> go into the ${a(cfg.links.kv, 'cache')}, so later tokens can read them without running your token again.`;
          }
          return `
            ${legend(P.latent ? ['vec', 'weight', 'rope', 'cache'] : ['vec', 'weight', 'cache'], colOf(toks, t), colOf(toks, Math.max(0, t - 1)))}
            ${figure(tracks, 'Query, key and value projections')}
            <p class="tk-read">One attention layer, position ${T1}. ${text}</p>
            <p class="tk-read">Every bar here still has your token’s colour only: a projection mixes the numbers of one vector, never the tokens. Lengths are on a square-root scale; the real sizes are under each shape.</p>`;
        },
        Heads: (toks, t) => {
          const c = colOf(toks, t);
          const own = pure(c);
          const T1 = t + 1;
          const tracks: Track[] = [];
          const zoomAt = (trs: Track[]) => {
            const x = Math.max(...trs.map((r) => r.x));
            trs.forEach((r) => (r.x = x));
          };
          let text: string;
          if (P.latent) {
            const dqk = P.dh + P.dr;
            const two = (r: boolean): Part[] => [{ f: P.dh / dqk, mix: own }, ...(r ? [{ f: P.dr / dqk, mix: own, rope: true }] : [])];
            const tq = new Track();
            tq.vec({ id: 'qc', len: Lp(nh * P.dh), parts: [{ f: 1, mix: own }], split: nh, pick: { strong: [0] }, name: 'q^{C}', size: `${nh} × ${P.dh}` });
            tq.vec({ id: 'qr', len: Lp(nh * P.dr), parts: [{ f: 1, mix: own, rope: true }], split: nh, pick: { strong: [0] }, name: 'q^{R}', size: `${nh} × ${P.dr}` });
            const tk = new Track();
            tk.vec({ id: 'kc', len: Lp(nh * P.dh), parts: [{ f: 1, mix: own }], split: nh, pick: { strong: [0] }, name: 'k^{C}', size: `${nh} × ${P.dh}` });
            tk.vec({ id: 'kr', len: Lp(P.dr), parts: [{ f: 1, mix: own, rope: true }], name: 'k^{R}, shared', size: fmt(P.dr) });
            const tv = new Track();
            tv.vec({ id: 'v', len: Lp(nh * P.dv), parts: [{ f: 1, mix: own }], split: nh, pick: { strong: [0] }, name: 'v', size: `${nh} × ${P.dv}` });
            zoomAt([tq, tk, tv]);
            tq.op('→ head 1, zoomed').vec({ id: 'q1', len: Lz(dqk), parts: two(true), name: 'q_{1} = [q^{C}_{1}, q^{R}_{1}]', size: `${fmt(dqk)} = ${P.dh} + ${P.dr}` });
            tk.op('→ head 1, zoomed').vec({ id: 'k1', len: Lz(dqk), parts: two(true), name: 'k_{1} = [k^{C}_{1}, k^{R}]', size: `${fmt(dqk)} = ${P.dh} + ${P.dr}` });
            tv.op('→ head 1, zoomed').vec({ id: 'v1', len: Lz(P.dv), parts: [{ f: 1, mix: own }], name: 'v_{1}', size: fmt(P.dv) });
            tracks.push(tq, tk, tv);
            text = `The long bars are cut into ${nh} heads of ${P.dh} (the thin lines; head 1 is outlined). Head 1’s query is two pieces joined end to end: its slice of q<sup>C</sup> and its slice of q<sup>R</sup>, ${P.dh} + ${P.dr} = ${fmt(dqk)} numbers. Its key is built the same way, except that the RoPE piece k<sup>R</sup> is one ${P.dr}-wide vector shared by all ${nh} heads. That is why the joined bars have two colours: a plain part that carries content and a hatched part that carries position.`;
          } else {
            const kvh = P.kvh;
            const gs = Math.max(1, Math.round(nh / kvh));
            const tq = new Track();
            tq.vec({ id: 'q', len: Lp(nh * P.dh), parts: [{ f: 1, mix: own }], split: nh, pick: { strong: [0], light: Array.from({ length: gs - 1 }, (_, i) => i + 1) }, name: `q_{${T1}}`, size: `${nh} heads × ${P.dh}` });
            const tk = new Track();
            tk.vec({ id: 'k', len: Lp(kvh * P.dh), parts: [{ f: 1, mix: own }], split: kvh, pick: { strong: [0] }, name: `k_{${T1}}`, size: `${kvh} head${kvh > 1 ? 's' : ''} × ${P.dh}` });
            const tv = new Track();
            tv.vec({ id: 'v', len: Lp(kvh * P.dv), parts: [{ f: 1, mix: own }], split: kvh, pick: { strong: [0] }, name: `v_{${T1}}`, size: `${kvh} head${kvh > 1 ? 's' : ''} × ${P.dv}` });
            zoomAt([tq, tk, tv]);
            tq.op('→ head 1, zoomed').vec({ id: 'q1', len: Lz(P.dh), parts: [{ f: 1, mix: own }], name: 'q_{1}', size: fmt(P.dh) });
            tk.op('→ head 1, zoomed').vec({ id: 'k1', len: Lz(P.dh), parts: [{ f: 1, mix: own }], name: 'k_{1}', size: fmt(P.dh) });
            tv.op('→ head 1, zoomed').vec({ id: 'v1', len: Lz(P.dv), parts: [{ f: 1, mix: own }], name: 'v_{1}', size: fmt(P.dv) });
            tracks.push(tq, tk, tv);
            text =
              kvh < nh
                ? `The query is cut into ${nh} heads of ${P.dh} (the thin lines), but the key and value only into ${kvh}. Query heads 1 to ${gs} (outlined) all use key/value head 1: ${a(cfg.head.link, 'grouped-query attention')} shares one key and value between ${gs} query heads, which shrinks the cache by ${gs}×.`
                : `The query, key and value are each cut into ${nh} heads of ${P.dh} (the thin lines). Head 1 (outlined) uses only its own slice of each.`;
          }
          return `
            ${legend(P.latent ? ['heads', 'rope'] : ['heads'], c, c)}
            ${figure(tracks, 'Splitting into heads')}
            <p class="tk-read">${text} Cutting a bar into heads moves no numbers: it only decides which numbers are compared with which in the next step.</p>`;
        },
        Scores: (toks, t) => {
          const T1 = t + 1;
          const { scores, w } = attend(toks, t, 0);
          const dqk = P.latent ? P.dh + P.dr : P.dh;
          const parts = (j: number): Part[] => (P.latent ? [{ f: P.dh / dqk, mix: pure(colOf(toks, j)) }, { f: P.dr / dqk, mix: pure(colOf(toks, j)), rope: true }] : [{ f: 1, mix: pure(colOf(toks, j)) }]);
          const lo = Math.min(...scores);
          const hi = Math.max(...scores);
          const tr = new Track();
          tr.vec({ id: 'q', len: Lz(dqk), parts: parts(t), name: `q_{${T1},1}`, size: fmt(dqk) });
          tr.mul(
            'q',
            { name: 'K^{T}, head 1', sub: `${fmt(dqk)} × ${T1} token${T1 > 1 ? 's' : ''}`, tokens: { dir: 'cols', parts: w.map((_, j) => parts(j)) } },
            { id: 's', len: T1 * CELL, cells: scores.map((s, j) => ({ fill: '#8a94a6', opacity: 0.15 + (0.75 * (s - lo)) / (hi - lo || 1), text: s.toFixed(1), tag: short(toks[j]) })), name: 'scores', size: `${T1}, one per token` },
          );
          tr.op('softmax');
          tr.vec({ id: 'w', len: T1 * CELL, cells: w.map((x, j) => ({ fill: colOf(toks, j), opacity: 0.15 + 0.85 * x, text: `${Math.round(x * 100)}`, tag: short(toks[j]) })), name: 'weights, %', size: 'sum to 100' });
          return `
            ${legend(P.latent ? ['vec', 'rope', 'weight'] : ['vec'], colOf(toks, t), colOf(toks, Math.max(0, t - 1)))}
            ${figure([tr], 'Attention scores for head 1')}
            <p class="tk-read">Here the matrix is not learned: it is the keys of the tokens your token may read, one column each, in their own colours${P.latent ? ' (with the shared RoPE part at the bottom)' : ''}. They were computed when those tokens passed and come from the cache; the last column is your own key. Your query runs down the left edge and is compared with each column: a dot product over ${fmt(dqk)} numbers, divided by √${fmt(dqk)}. That gives ${T1} score${T1 > 1 ? 's' : ''}, and ${a(cfg.links.softmax, 'softmax')} turns them into weights that sum to 1.</p>
            <p class="tk-read">One head’s vectors are drawn larger here than in the Q, K, V step. Tokens to the right of yours have no column: they don’t exist yet when your token is computed. The scores and weights are made up ${EX}, because the real ones depend on the trained weights.</p>`;
        },
        'Mix values': (toks, t) => {
          const T1 = t + 1;
          const { w } = attend(toks, t, 0);
          const tr = new Track();
          tr.vec({ id: 'w', len: T1 * CELL, cells: w.map((x, j) => ({ fill: colOf(toks, j), opacity: 0.15 + 0.85 * x, text: `${Math.round(x * 100)}`, tag: short(toks[j]) })), name: 'weights, %', size: `${T1}` });
          tr.mul('w', { name: 'V, head 1', sub: `${T1} token${T1 > 1 ? 's' : ''} × ${fmt(P.dv)}`, tokens: { dir: 'rows', parts: w.map((_, j) => [{ f: 1, mix: pure(colOf(toks, j)) }]) } }, { id: 'o', len: Lz(P.dv), parts: [{ f: 1, mix: blendOf(toks, w) }], name: `o_{${T1},1}`, size: fmt(P.dv) });
          const others = new Track('Other heads, same tokens, their own weights');
          const nShow = Math.min(nh, 5);
          for (let i = 1; i < nShow; i++) others.vec({ id: `o${i}`, len: Lz(P.dv), parts: [{ f: 1, mix: blendOf(toks, attend(toks, t, i).w) }], name: `o_{${T1},${i + 1}}`, size: fmt(P.dv) });
          if (nh > nShow) others.op('…', 'tp-op dots').vec({ id: 'on', len: Lz(P.dv), parts: [{ f: 1, mix: blendOf(toks, attend(toks, t, nh - 1).w) }], name: `o_{${T1},${nh}}`, size: fmt(P.dv) });
          return `
            ${legend(['vec', 'mix'], colOf(toks, t), colOf(toks, Math.max(0, t - 1)))}
            ${figure(nh > 1 ? [tr, others] : [tr], 'Weighted sum of values for head 1')}
            <p class="tk-read">The weights now run down the left edge of the values: one row per token, the value vectors those tokens left in the cache. Each output number is the weighted sum down one column, so the head’s output o<sub>${T1},1</sub> is a blend of the tokens’ values. This is the first step that mixes tokens, and it is why the bar is striped: each stripe’s thickness is that token’s weight.</p>
            <p class="tk-read">Every head does the same with its own query and key slices, so every head blends the tokens in its own proportions (second row). The weights are made up ${EX}.</p>`;
        },
        'Join heads': (toks, t) => {
          const T1 = t + 1;
          const c = colOf(toks, t);
          const heads = Array.from({ length: nh }, (_, i) => attend(toks, t, i).w);
          const tr = new Track();
          tr.vec({ id: 'o', len: Lp(nh * P.dv), parts: heads.map((w) => ({ f: 1 / nh, mix: blendOf(toks, w) })), split: nh, name: `o_{${T1}} = [o_{1}, …, o_{${nh}}]`, size: `${fmt(nh * P.dv)} = ${nh} × ${P.dv}` });
          tr.mul('o', { name: 'W^{O}', sub: `${fmt(nh * P.dv)} → ${fmt(cfg.d)}` }, { id: 'a', len: Lp(cfg.d), parts: [{ f: 1, mix: blendOf(toks, meanW(heads)) }], name: 'attention out', size: fmt(cfg.d) });
          tr.op('+').vec({ id: 'h', len: Lp(cfg.d), parts: [{ f: 1, mix: pure(c) }], name: `h_{${T1}}`, size: fmt(cfg.d) });
          tr.op('=').vec({ id: 'h2', len: Lp(cfg.d), parts: [{ f: 1, mix: residual(toks, t, heads) }], name: `new h_{${T1}}`, size: fmt(cfg.d) });
          const len = Math.min(Lp(cfg.d), 220);
          const tag = (j: number) => short(toks[j]);
          const seq = row([
            sequence('Before this layer', toks.map((_, j) => ({ mix: pure(colOf(toks, j)), tag: tag(j), cur: j === t })), len),
            sequence('After it', toks.map((_, j) => ({ mix: residual(toks, j, Array.from({ length: Math.min(nh, 16) }, (_, i) => attend(toks, j, i).w)), tag: tag(j), cur: j === t })), len),
          ]);
          return `
            ${legend(['vec', 'mix', 'weight', 'heads'], c, colOf(toks, Math.max(0, t - 1)))}
            ${figure([tr, seq], 'Joining heads and the residual add')}
            <p class="tk-read">The ${nh} head outputs are joined end to end into one bar of ${fmt(nh * P.dv)}, each slice with its own blend. W<sup>O</sup> mixes the slices into ${fmt(cfg.d)} numbers, and the result is added to h<sub>${T1}</sub>, the bar your token came in with. The new h<sub>${T1}</sub> keeps a thick stripe of your token’s colour and gains stripes from the tokens it read: your token has been recoloured.</p>
            <p class="tk-read">All tokens go through this at once (right). The first token can read only itself, so it keeps one colour; later tokens pick up more colours. After ${cfg.L} layers each bar holds a blend of everything before it. The proportions are made up ${EX}.</p>`;
        },
        Cache: (toks, t) => {
          const c = cfg.cache;
          const chips = toks
            .map((x, j) => `<span class="tk-c ${j < t ? 'cache' : j === t ? 'cache cur' : 'future'}">${j <= t ? show(x) : ''}</span>`)
            .join('');
          const lines: string[] = [];
          if (c.attnPerLayer)
            lines.push(
              `<li><b>Attention</b>, in each of ${c.attnLayers} layers: ${c.attnParts} = <b>${fmt(c.attnPerLayer)}</b> numbers. Over all ${c.attnLayers}: ${fmt(c.attnPerLayer * c.attnLayers)} numbers${c.bytesText ? `, <b>${c.bytesText}</b> per token at 16 bits` : ''}.${c.sparse ? ' The sparse indexer also keeps a small key per token, not counted here.' : ''} This part grows by the same amount for every token.</li>`,
            );
          else if (c.attnLayers) lines.push(`<li><b>Attention</b>, in each of ${c.attnLayers} layers: the token’s keys and values. The data doesn’t give enough sizes to count them.</li>`);
          for (const f of c.fixed) lines.push(`<li><b>${esc(f.label)}</b>, in each of ${f.layers} layers: ${esc(f.what)} = ${fmt(f.numbers)} numbers, a <b>fixed size</b>. Your token updates it in place instead of adding to it.</li>`);
          const grow = c.bytes ? `After ${t + 1} token${t ? 's' : ''} the attention cache holds ${bytes(c.bytes * (t + 1))}${c.ctxText ? `; at the full ${esc(String(c.ctxLen))} context it holds ${c.ctxText}` : ''}.` : '';
          return `
            <div class="tk-scroll" data-keep-scroll><div class="tk-cells" style="--n:${toks.length}">${chips}</div></div>
            <p class="tk-read">When the model writes text, it adds one token at a time, and only the new token goes through the layers. Whatever later tokens need from yours is stored in the ${a(cfg.links.kv, 'cache')} when it passes:</p>
            <ul class="tk-notes">${lines.join('')}</ul>
            <p class="tk-read">${grow} Earlier tokens are never recomputed; a new token reads them from the cache.</p>`;
        },
        Experts: (toks, t) => render.FFN(toks, t),
        FFN: (toks, t) => {
          const f = cfg.ffn;
          const parts: string[] = [];
          if (f.dense)
            parts.push(`
              <div class="tk-flow">
                <span class="tk-box act"><b>h<sub>${t + 1}</sub></b><small>${fmt(cfg.d)}</small></span><span class="tk-arrow">→</span>
                <span class="tk-box weight"><b>gate, up</b><small>${fmt(cfg.d)} → ${f.dense.dff ? fmt(f.dense.dff) : 'd_ff'}</small></span><span class="tk-arrow">→</span>
                <span class="tk-box op"><b>${esc(f.dense.act ?? 'activation')} · multiply</b><small>${f.dense.dff ? fmt(f.dense.dff) : 'd_ff'}</small></span><span class="tk-arrow">→</span>
                <span class="tk-box weight"><b>down</b><small>→ ${fmt(cfg.d)}</small></span>
              </div>
              <p class="tk-read"><b>Dense FFN</b>${f.dense.where ? ` (layers ${f.dense.where})` : ''}: your token alone goes out to ${f.dense.dff ? fmt(f.dense.dff) : 'd_ff'} numbers and back to ${fmt(cfg.d)}. Every token uses the same weights.</p>`);
          if (f.moe) {
            const { Nr, Kr, Ns, groups, groupsActive } = f.moe;
            const id = toks[t].id;
            // Example routing that respects the model's limits: first pick groups, then experts in them.
            const per = groups ? Nr / groups : Nr;
            const gPick = groups && groupsActive ? [...Array(groups).keys()].sort((x, y) => hash(id, 7, x) - hash(id, 7, y)).slice(0, groupsActive) : [...Array(groups || 1).keys()];
            const pool = gPick.flatMap((g) => Array.from({ length: per }, (_, i) => g * per + i));
            const picked = new Set(pool.sort((x, y) => hash(id, 3, x) - hash(id, 3, y)).slice(0, Kr));
            const cols = groups ? per : Math.min(32, Math.ceil(Math.sqrt(Nr * 2)));
            const cells = Array.from({ length: Nr }, (_, e) => {
              const g = groups ? Math.floor(e / per) : 0;
              const cls = picked.has(e) ? 'on' : groups && groupsActive && !gPick.includes(g) ? 'off' : '';
              return `<i class="${cls}" title="expert ${e + 1}${picked.has(e) ? ' (example pick)' : ''}"></i>`;
            }).join('');
            parts.push(`
              <div class="tk-moe">
                <div class="tk-scroll" data-keep-scroll><div class="tk-experts" style="--cols:${cols}">${cells}</div></div>
                ${Ns ? `<div class="tk-shared">${Array.from({ length: Ns }, () => '<i class="on"></i>').join('')}<small>${Ns} shared</small></div>` : ''}
              </div>
              <p class="tk-read"><b>${a(f.moe.link, 'MoE FFN')}</b>${f.moe.where ? ` (layers ${f.moe.where})` : ''}: a router scores all ${fmt(Nr)} routed experts for your token and keeps ${Kr}${groups && groupsActive ? `, taken from at most ${groupsActive} of ${groups} groups (one row per group)` : ''}.${Ns ? ` ${Ns === 1 ? 'The shared expert runs' : `The ${Ns} shared experts run`} for every token.` : ''} Each expert is a small FFN, ${fmt(cfg.d)} → ${f.moe.de ? fmt(f.moe.de) : 'd_e'} → ${fmt(cfg.d)}. The highlighted experts are made up ${EX}: the real choice depends on the trained router, and every token, in every layer, gets its own. Click another token to see the picks change.</p>
              ${cfg.params.active ? `<p class="tk-read">This is why only ${cfg.params.active} of the model’s ${cfg.params.total} parameters run for each token.</p>` : ''}`);
          }
          return parts.join('');
        },
        Output: (toks, t) => {
          const next = toks[t + 1];
          return `
            <div class="tk-flow">
              <span class="tk-box act"><b>h<sub>${t + 1}</sub></b><small>after layer ${cfg.L}, ${fmt(cfg.d)}</small></span><span class="tk-arrow">→</span>
              <span class="tk-box op"><b>${cfg.norm}</b></span><span class="tk-arrow">→</span>
              <span class="tk-box weight"><b>Output head</b><small>${fmt(cfg.d)} → ${fmt(cfg.V)}</small></span><span class="tk-arrow">→</span>
              <span class="tk-box act"><b>logits</b><small>${fmt(cfg.V)}, one per id</small></span><span class="tk-arrow">→</span>
              <span class="tk-box op"><b>softmax</b><small>probabilities</small></span>
            </div>
            <p class="tk-read">The final hidden state of position ${t + 1} gets one score for every id in the vocabulary, ${fmt(cfg.V)} in all${cfg.tied ? '; the head reuses the embedding table, turned around' : ''}. Softmax turns them into probabilities for the token that comes <em>next</em>.</p>
            <p class="tk-read">${
              next
                ? `In training, these probabilities are scored against the real next token, <code>${show(next)}</code> (id ${fmt(next.id)}): the loss is −log of the probability given to ${fmt(next.id)}. Every position is scored this way at once.`
                : `This is the last token of the sample, so when generating, an id is sampled from these probabilities and fed back in as token ${t + 2}: the loop of the Whole model view.`
            } When generating, only the last position’s output is used.</p>`;
        },
      };

      this.apply = (s) => {
        const set = Math.max(0, Math.min(cfg.sets.length - 1, s.set | 0));
        const toks: Tok[] = cfg.sets[set].tokens;
        const t = Math.max(0, Math.min(toks.length - 1, s.t | 0));
        const stage = Math.max(0, Math.min(stages.length - 1, s.stage | 0));
        this.st = { set, t, stage };
        this.querySelectorAll('[data-set]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.set === String(set))));
        this.querySelectorAll('[data-stage]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.stage === String(stage))));
        q<HTMLElement>('[data-out="tokens"]').innerHTML = toks
          .map((x, j) => `<button type="button" class="tk-tok${x.special ? ' special' : ''}${j === t ? ' cur' : ''}" data-j="${j}" aria-pressed="${j === t}" style="--tc:${tokColor(j, x.special)}"><span class="tt">${show(x)}</span><span class="ti">${fmt(x.id)}</span></button>`)
          .join('');
        q<HTMLElement>('[data-out="stage"]').innerHTML = render[stages[stage]](toks, t);
        q<HTMLElement>('[data-out="pos"]').textContent = `${stage + 1} / ${stages.length}`;
        q<HTMLButtonElement>('[data-step="-1"]').disabled = stage === 0;
        q<HTMLButtonElement>('[data-step="1"]').disabled = stage === stages.length - 1;
      };

      this.addEventListener('click', (e) => {
        const el = e.target as HTMLElement;
        if (el.closest('a')) return;
        const tk = el.closest<HTMLElement>('.tk-tok[data-j]');
        const set = el.closest<HTMLElement>('[data-set]');
        const stage = el.closest<HTMLElement>('[data-stage]');
        const step = el.closest<HTMLElement>('[data-step]');
        if (tk) this.apply({ ...this.st, t: Number(tk.dataset.j) });
        else if (set) this.apply({ ...this.st, set: Number(set.dataset.set) });
        else if (stage) this.apply({ ...this.st, stage: Number(stage.dataset.stage) });
        else if (step) this.apply({ ...this.st, stage: this.st.stage + Number(step.dataset.step) });
      });
      this.apply(this.st);
    }
  }
  customElements.define('x-tokentrace', XTokenTrace);
</script>

