---
// Same encoding as the graph: shape is the kind, fill is how far the note has been checked.
interface Props {
  status: 'stub' | 'draft' | 'reviewed' | 'verified';
  kind?: 'concept' | 'system' | 'path';
  size?: number;
}
const { status, kind = 'concept', size = 11 } = Astro.props;
const labels = {
  stub: 'Stub: placeholder, not written yet',
  draft: 'Draft: written by an agent, not reviewed',
  reviewed: 'Reviewed: read through, specs not yet checked against sources',
  verified: 'Verified: specs checked against the cited sources',
};
const s = 10;
const shape =
  kind === 'system'
    ? `<rect x="1.5" y="1.5" width="${s - 3}" height="${s - 3}" />`
    : kind === 'path'
      ? `<path d="M5 0.8 L9.2 5 L5 9.2 L0.8 5 Z" />`
      : `<circle cx="5" cy="5" r="3.7" />`;
---

<svg
  class:list={['status-mark', `status-${status}`]}
  width={size}
  height={size}
  viewBox="0 0 10 10"
  role="img"
  aria-label={labels[status]}
>
  <title>{labels[status]}</title>
  <defs>
    <clipPath id={`half-${kind}`}><rect x="0" y="5" width="10" height="5" /></clipPath>
  </defs>
  <g set:html={shape} />
  {status === 'reviewed' && <g clip-path={`url(#half-${kind})`} class="fill" set:html={shape} />}
</svg>

<style>
  .status-mark {
    flex: none;
    vertical-align: -0.05em;
    overflow: visible;
  }
  .status-mark :global(circle),
  .status-mark :global(rect),
  .status-mark :global(path) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .status-stub :global(*) {
    stroke: var(--ink-faint) !important;
    stroke-dasharray: 1.6 1.4;
  }
  .status-verified :global(circle),
  .status-verified :global(rect),
  .status-verified :global(path),
  .status-mark .fill :global(*) {
    fill: var(--ink);
  }
</style>
