---
// Which keys each query may read: an n × n grid, query tokens down, key tokens across. Several
// masks can be compared with tabs; clicking a row picks the query token and states what it reads.
// Answers "which tokens can attend to which?" (causal, sliding window, conv kernel, sparse top-k).
//   <MaskGrid title="..." n={12} masks={[{ label: 'Causal', kind: 'causal' }, { label: 'Window', kind: 'window', window: 4 }]} />
// kinds: full | causal | window (needs window) | topk (needs k; illustrative picks, same on every load)
interface Mask {
  label: string;
  kind: 'full' | 'causal' | 'window' | 'topk';
  window?: number;
  k?: number;
}
interface Props {
  title: string;
  masks: Mask[];
  n?: number;
  caption?: string;
}
const { title, masks, n = 12, caption } = Astro.props;
if (!masks?.length) throw new Error(`<MaskGrid title="${title}">: needs at least one mask`);
if (n < 4 || n > 24) throw new Error(`<MaskGrid title="${title}">: n must be between 4 and 24`);

// Deterministic "learned" picks for topk, so the layout is the same on every load (keep-place).
const hash = (i: number, j: number) => ((i * 73856093) ^ (j * 19349663)) % 1000;
function allowed(m: Mask, i: number, j: number): boolean {
  if (m.kind === 'full') return true;
  if (j > i) return false;
  if (m.kind === 'causal') return true;
  if (m.kind === 'window') return i - j < (m.window ?? 1);
  if (m.kind === 'topk') {
    const k = m.k ?? 1;
    if (i < k) return true;
    const ranked = [...Array(i).keys()].sort((a, b) => hash(i, b) - hash(i, a)).slice(0, k - 1);
    return j === i || ranked.includes(j);
  }
  return false;
}
const grids = masks.map((m) => [...Array(n).keys()].map((i) => [...Array(n).keys()].map((j) => allowed(m, i, j))));
const C = 18;
const L = 26; // room for axis labels
const size = L + n * C;
const config = JSON.stringify({ n, masks: masks.map((m) => m.label) });
---

<x-maskgrid class="maskgrid ui" data-restorable>
  <script type="application/json" set:html={config} />
  <p class="title">{title}</p>
  {
    masks.length > 1 && (
      <div class="tabs" role="tablist">
        {masks.map((m, k) => (
          <button type="button" role="tab" data-mask={k} aria-selected={k === 0 ? 'true' : 'false'}>
            {m.label}
          </button>
        ))}
      </div>
    )
  }
  <div class="body">
    <svg viewBox={`0 0 ${size} ${size}`} width={size} style={`width:${+(size / 17).toFixed(3)}rem`} role="img" aria-label={title}>
      <text class="axis" x={L + (n * C) / 2} y="10" text-anchor="middle">key token j →</text>
      <text class="axis" x="10" y={L + (n * C) / 2} text-anchor="middle" transform={`rotate(-90 10 ${L + (n * C) / 2})`}>query token t →</text>
      {
        grids.map((g, k) => (
          <g class="grid" data-mask={k} hidden={k !== 0}>
            {g.map((row, i) =>
              row.map((ok, j) => <rect class:list={['cell', { ok }]} data-row={i} x={L + j * C + 1} y={L + i * C + 1} width={C - 2} height={C - 2} rx="2" />),
            )}
          </g>
        ))
      }
      <rect class="rowmark" x={L - 2} y={L} width={n * C + 4} height={C} rx="3" />
    </svg>
    <p class="readout" aria-live="polite"></p>
  </div>
  {caption && <p class="caption">{caption}</p>}
  <p class="hint">Click a row to pick the query token.</p>
</x-maskgrid>

<script>
  // Restorable (src/scripts/trail.ts): the selected mask and query row come back on return.
  class XMaskGrid extends HTMLElement {
    m = 0;
    q = -1;
    snapshot() {
      return this.m || this.q >= 0 ? { m: this.m, q: this.q } : null;
    }
    restore(s: unknown) {
      const st = s as { m: number; q: number };
      if (st && typeof st.m === 'number') this.show(st.m, st.q);
    }
    show(m: number, q: number) {}
    connectedCallback() {
      const cfg = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const n: number = cfg.n;
      const grids = [...this.querySelectorAll<SVGGElement>('g.grid')];
      const mark = this.querySelector<SVGRectElement>('.rowmark')!;
      const readout = this.querySelector('.readout')!;
      const C = 18;
      const L = 26;
      this.show = (m: number, q: number) => {
        this.m = Math.max(0, Math.min(grids.length - 1, m));
        this.q = q >= 0 && q < n ? q : n - 1;
        grids.forEach((g, k) => (g.hidden = k !== this.m));
        this.querySelectorAll('[role=tab]').forEach((t, k) => t.setAttribute('aria-selected', String(k === this.m)));
        mark.setAttribute('y', String(L + this.q * C));
        const cells = [...grids[this.m].querySelectorAll<SVGRectElement>(`[data-row="${this.q}"]`)];
        grids[this.m].querySelectorAll('.picked').forEach((c) => c.classList.remove('picked'));
        cells.forEach((c) => c.classList.add('picked'));
        const reads = cells.filter((c) => c.classList.contains('ok')).length;
        readout.textContent = `${cfg.masks[this.m]}: token ${this.q + 1} reads ${reads} of ${this.q + 1} tokens up to itself.`;
      };
      this.querySelector('.tabs')?.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mask]');
        if (b) this.show(Number(b.dataset.mask), this.q);
      });
      this.querySelector('svg')!.addEventListener('click', (e) => {
        const r = (e.target as Element).closest('[data-row]');
        if (r) this.show(this.m, Number(r.getAttribute('data-row')));
      });
      this.show(this.m, this.q);
    }
  }
  customElements.define('x-maskgrid', XMaskGrid);
</script>

<style>
  .maskgrid {
    display: block;
    margin: 2rem 0;
    padding: 1rem 1.1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
  }
  .title {
    margin: 0 0 0.6rem;
    font-weight: 600;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }
  .tabs button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-raised);
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    align-items: center;
  }
  svg {
    max-width: 100%;
    height: auto;
    cursor: pointer;
  }
  .axis {
    font-size: 9px;
    fill: var(--ink-faint);
  }
  .cell {
    fill: var(--paper);
    stroke: var(--rule-soft);
  }
  .cell.ok {
    fill: var(--role-cache-wash);
    stroke: var(--role-cache);
  }
  .cell.ok.picked {
    fill: var(--role-cache);
  }
  .rowmark {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    pointer-events: none;
  }
  .readout {
    flex: 1 1 12rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
  }
  .caption,
  .hint {
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .hint {
    color: var(--ink-faint);
    font-size: 0.75rem;
  }
</style>
