---
// A model's whole architecture, generated from its data: text → tokenizer → embedding → layer
// stack → final norm → output head → next token (or, for kind: pipeline, its stages from input to
// output with the backbone opening one block), then one tab per part (a layer, each mixer, each
// FFN kind, MTP) drawn down to the projections and tensor shapes. Sizes are drawn as this model's
// numbers, read from its data (only T, the sequence length, stays a symbol); the table under them
// maps each number to the symbol the concept notes use, with its source, so nothing is retyped.
// A language model also gets a "Follow a token" tab (../overview/TokenTrace.astro): one real token
// of a sample text followed through the same model, stage by stage.
//   <ModelOverview model="deepseek-v3" />
// Generators: src/lib/models/overview.mjs (also linted by scripts/checks/models.mjs).
import ArchDiagram from './ArchDiagram.astro';
import { requireModel, modelData } from '../../lib/models/load';
import { overviewParts, symbolRows } from '../../lib/models/overview.mjs';
import { lintDiagram } from '../../lib/diagram/geometry.mjs';
import { FIELD, formatValue } from '../../lib/models/fields.mjs';
import { DERIVED, formatDerived } from '../../lib/models/data.mjs';
import { noteUrl } from '../../lib/url';
import { paramBreakdown, sublayerWeights, fmtParams } from '../../lib/models/params.mjs';
import TokenTrace from '../overview/TokenTrace.astro';
import { samplesFor } from '../../lib/tokenizers/samples';

interface Props {
  model: string;
  caption?: string;
}
const { model: id, caption } = Astro.props;
const d = await modelData();
const m = await requireModel(id, '<ModelOverview>');
const tok = d.tokenizers.get(m.values.tokenizer?.v);
const ctx = { has: (s: string) => d.notes.has(s), tokenizer: tok ? { title: tok.title, note: tok.note, algorithm: tok.algorithm?.v } : null };
const parts = overviewParts(m, ctx);
for (const p of parts) {
  const errors = lintDiagram(p.props).filter((x: any) => x.level === 'error');
  if (errors.length) throw new Error(`<ModelOverview model="${id}"> part "${p.id}" fails diagram-geometry:\n${errors.map((e: any) => `  ${e.msg}`).join('\n')}`);
}

const attn = String(m.values.attention?.v ?? '');
const pipeline = m.kind === 'pipeline';
const unit = String(m.values.seq_unit?.v ?? 'step');
// A size in a caption: the model's number, or the symbol when the data doesn't have it.
const z = (key: string, sym: string) => {
  const x = m.values[key]?.v ?? m.derived[key]?.v;
  return typeof x === 'number' ? x.toLocaleString('en-US') : sym;
};
const CAPTIONS: Record<string, string> = {
  model: 'From text to the next token. The dashed arrow on the left is decoding: the sampled id is appended and the model runs again, and only the new token passes through the stack because the caches hold the earlier ones.',
  layer: m.values.hc_streams
    ? `One layer. mHC keeps the residual as ${z('hc_streams', 'n_hc')} copies of width ${z('hidden_size', 'd')}. Input map A mixes them into the sublayer; the left arrows are the mHC add (B mixes the copies, C writes the sublayer output back).`
    : `One layer. Each sublayer reads a normalized copy of the residual stream and adds its result back (the arrows on the left), so the stream keeps shape T × ${z('hidden_size', 'd')} all the way up.`,
  'mixer-A':
    attn === 'mla'
      ? 'Queries and keys/values pass through narrow latents. Only c^KV and the shared RoPE key k^R are cached; the full keys and values are rebuilt from c^KV, and the up-projections can be folded into the query and output projections at inference.'
      : attn === 'gqa'
        ? `Each query head scores every earlier token. With grouped-query attention several query heads share one cached key/value head, so the cache holds ${z('kv_heads', 'n_kv')} heads instead of ${z('heads', 'n_h')}.`
        : 'Each query head scores every earlier token, reading the keys and values of past tokens from the cache.',
  'mixer-C': `Two gates around a depthwise convolution with a short kernel. While decoding, the layer only keeps the last ${z('conv_window', 'k')} inputs, so its cache never grows with context.`,
  'mixer-G': `Gated DeltaNet linear attention: a depthwise convolution (kernel ${z('conv_window', 'k')}) feeds the gated delta recurrence S_t = α_t S + β_t (v − S k) kᵀ over a fixed-size ${z('linear_v_heads', 'n_v')} × ${z('linear_k_dim', 'd_qk')} × ${z('linear_v_dim', 'd_v')} state per layer, so state memory never grows with context.`,
  'ffn-D': 'A gated FFN: the gate path goes through the activation and multiplies the up path element by element, then the down projection returns to width d.',
  'ffn-E': `The router scores all ${z('routed_experts', 'N_r')} routed experts and keeps ${z('active_experts', 'K_r')}; their outputs are mixed by the gate weights g.${m.values.shared_experts ? ' Shared experts run for every token.' : ''}`,
  mtp: 'Used in training: predicts one token further ahead, reusing the main model’s embedding table and output head.',
  engram: `Hashed suffix n-grams (orders 2 to ${z('engram_max_ngram', 'n')}) are looked up in ${z('engram_heads', 'K_e')} tables per order. The hidden state gates what comes back, so a colliding or off-topic entry can be ignored.`,
  mhc: `The residual is ${z('hc_streams', 'n_hc')} copies of width ${z('hidden_size', 'd')}. A mixes them into the layer; B, projected onto doubly stochastic matrices by ${z('hc_sinkhorn_iters', 't_max')} Sinkhorn rounds, mixes the copies; C writes the layer output back.`,
};
if (pipeline) {
  const steps = m.values.sampling_steps ? ` and run ${z('sampling_steps', 'N')} times while sampling` : '';
  const k = m.values.tokens_per_step ? `${z('tokens_per_step', 'n_tok')} tokens per ${unit}` : `one token per ${unit}`;
  Object.assign(CAPTIONS, {
    model: `From input to output. Stages marked frozen are off-the-shelf models used as they are; the backbone is drawn from the model data${steps}.`,
    layer: `One backbone block, sublayers in order. Each reads a normalized copy of the residual stream and adds its result back (the arrows on the left).${m.values.modulation ? ' The norms are adaptive: their scale and shift come from the conditioning vector m_t.' : ''} The sequence holds ${k}.`,
    'mixer-A': `Every token attends to every other token of the sample, earlier or later, so there is no mask and nothing is cached between sampling steps.`,
    'mixer-X': `The backbone’s tokens query the conditioning inputs${m.values.cross_inputs ? ` (${String(m.values.cross_inputs.v)})` : ''}. Keys and values come from those inputs, so the sequence keeps its length.`,
  });
}

const value = (key: string | null) => {
  if (!key) return { text: 'varies' };
  const v = m.values[key];
  if (v) {
    const s = d.sources.get(v.source);
    return { text: formatValue(FIELD[key], v), url: s?.url, title: `${s?.short ?? v.source}, ${v.where}${v.inherited ? ` (from ${v.from})` : ''}` };
  }
  const dv = m.derived[key];
  if (dv) return { text: formatDerived(DERIVED.find((x) => x.key === key)!, dv.v), title: `derived: ${dv.formula}` };
  return { text: '—' };
};
const symbols = symbolRows(m).map((r: any) => ({ ...r, ...value(r.key) }));

// Parameters: every matrix the views draw, sized from the data and summed (src/lib/models/params.mjs).
// A derivation, so it is shown beside the reported totals, never instead of them.
const pb = paramBreakdown(m);
const n = (x: number) => x.toLocaleString('en-US');
const CODE_LABEL: Record<string, string> = { A: parts.find((p) => p.id === 'mixer-A')?.tab ?? 'Attention', X: 'Cross-attention', C: 'Gated conv', M: 'Mamba-2', G: 'Gated DeltaNet', D: pipeline ? 'FFN' : 'Dense FFN', E: 'MoE FFN' };
const times = (p: any, x: number) => (p.layers > 1 ? `${p.layers} ${pipeline ? 'blocks' : 'layers'} × ${fmtParams(x)}` : undefined);
const bars: { label: string; sub?: string; total: number; active: number; title: string }[] = [];
for (const p of pb.parts as any[]) {
  if (p.code === 'E') {
    for (const r of p.rows) {
      const act = r.active ?? r.params;
      bars.push({ label: r.name === 'Router' ? 'MoE router' : r.name, sub: times(p, r.params), total: r.params * p.layers, active: act * p.layers, title: `${r.copiesText} matrices of ${n(r.in)} × ${n(r.out)}, in ${p.layers} layers` });
    }
  } else if (p.code) {
    bars.push({ label: CODE_LABEL[p.code], sub: times(p, p.perLayer), total: p.total, active: p.active, title: p.rows.map((r: any) => `${r.name}: ${n(r.in)} × ${n(r.out)}${r.copies > 1 ? ` × ${r.copies}` : ''}`).join('; ') + ` — per layer, × ${p.layers} layers` });
  } else {
    bars.push({ label: p.label, sub: p.note, total: p.total, active: p.active, title: p.rows.map((r: any) => `${r.name}: ${n(r.in)} × ${n(r.out)}`).join('') || p.note });
  }
}
const barMax = Math.max(...bars.map((b) => b.total), 1);
const share = (x: number) => {
  const f = (x / Math.max(pb.total, 1)) * 100;
  return f >= 1 ? `${Math.round(f)}%` : f >= 0.1 ? `${f.toFixed(1)}%` : '<0.1%';
};
// The longest bar takes 68% of the track, leaving room for its value label.
const pct = (x: number) => `${Math.max((x / barMax) * 68, x > 0 ? 0.4 : 0)}%`;
const moe = (pb.parts as any[]).some((p) => p.code === 'E');
const off = (sum: number, rep: number | null) => (rep ? (sum - rep) / rep : null);
const offTotal = pb.complete ? off(pb.total, pb.reported.total) : null;
const offActive = pb.complete && moe ? off(pb.active, pb.reported.active) : null;
const pctText = (x: number) => `${x > 0 ? '+' : '−'}${Math.abs(x * 100).toFixed(1)}%`;
if (bars.length) parts.push({ id: 'params', tab: 'Parameters', props: null } as any);
// Token level: a language model with a layer pattern and generated tokenizer samples gets a
// "Follow a token" tab right after the whole-model view (src/components/overview/TokenTrace.astro).
const hasSamples = (() => {
  try {
    return !!(m.values.tokenizer?.v && samplesFor(String(m.values.tokenizer.v), ''));
  } catch {
    return false;
  }
})();
const tokenTab = !pipeline && !!m.values.layer_pattern && !!tok && hasSamples;
if (tokenTab) parts.splice(1, 0, { id: 'token', tab: 'Follow a token', props: null } as any);

// The matrices behind one tab: mixer-A → A, ffn-E → E; the layer tab sums each sublayer kind.
const TAB_CODE: Record<string, string> = { 'mixer-A': 'A', 'mixer-X': 'X', 'mixer-C': 'C', 'mixer-G': 'G', 'ffn-D': 'D', 'ffn-E': 'E' };
const weightTable = (tab: string) => {
  const code = TAB_CODE[tab];
  if (!code) return null;
  const w = sublayerWeights(m, code) as any;
  if (!w.rows) return null;
  const part = (pb.parts as any[]).find((p) => p.code === code);
  return { rows: w.rows, copies: w.rows.some((r: any) => r.copiesText), missing: w.missing, perLayer: part?.perLayer, layers: part?.layers, total: part?.total, active: code === 'E' ? part?.active / part?.layers : null };
};
const layerRows = (pb.parts as any[]).filter((p) => p.code);

const config = JSON.stringify({ tabs: parts.map((p) => p.id) });
---

<x-modeloverview class="overview ui" data-restorable>
  <script type="application/json" set:html={config} />
  <div class="tabs" role="tablist" aria-label={`${m.title} architecture views`}>
    {
      parts.map((p, i) => (
        <button type="button" role="tab" data-tab={p.id} aria-selected={i === 0 ? 'true' : 'false'}>
          {p.tab}
        </button>
      ))
    }
  </div>
  {
    parts.map((p, i) => {
      const wt = weightTable(p.id);
      return (
      <div class="panel" role="tabpanel" data-panel={p.id} hidden={i !== 0} data-test-reveal>
        {p.id === 'model' && <p class="hint">Blocks with a <span class="plus" aria-hidden="true">+</span> zoom in: {pipeline ? 'the backbone opens one block, and inside it each sublayer opens its projections and weights.' : 'the layer stack opens one layer, and inside it each mixer and FFN opens its projections and weights.'}</p>}
        {p.props && <ArchDiagram {...p.props} caption={CAPTIONS[p.id]} />}
        {p.id === 'token' && <TokenTrace model={m} tokenizer={tok} has={ctx.has} />}
        {wt && (
          <div class="wscroll" data-keep-scroll>
            <p class="tcap">Weights in this view, sized from the data. Hover a shape for its symbols.</p>
            <table class="weights">
              <thead><tr><th>Matrix</th><th>Shape, in × out</th>{wt.copies && <th>Copies</th>}<th class="num">Parameters</th></tr></thead>
              <tbody>
                {wt.rows.map((r: any) => (
                  <tr>
                    <td><span class="mname">{r.name}</span><span class="what">{r.what}</span></td>
                    <td class="mono" title={`${r.inSym} × ${r.outSym}`}>{n(r.in)} × {n(r.out)}</td>
                    {wt.copies && <td class="mono">{r.copiesText}</td>}
                    <td class="num mono">{fmtParams(r.params)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr><td colspan={wt.copies ? 3 : 2}>{pipeline ? 'One block' : 'One layer'}{wt.layers > 1 ? `, × ${wt.layers} ${pipeline ? 'blocks' : 'layers'}` : ''}</td><td class="num mono">{fmtParams(wt.perLayer)}{wt.layers > 1 && <> → {fmtParams(wt.total)}</>}</td></tr>
                {wt.active != null && <tr><td colspan={wt.copies ? 3 : 2}>Run for each token, one layer</td><td class="num mono">{fmtParams(wt.active)}</td></tr>}
              </tfoot>
            </table>
            {wt.missing && <p class="pnote">Not counted: the {wt.missing}, whose shapes the data doesn’t give.</p>}
          </div>
        )}
        {p.id === 'layer' && layerRows.length > 0 && (
          <div class="wscroll" data-keep-scroll>
            <p class="tcap">Parameters per {pipeline ? 'block' : 'layer'} of each kind; the + on each block opens its weights.</p>
            <table class="weights">
              <thead><tr><th>Sublayer</th><th class="num">{pipeline ? 'One block' : 'One layer'}</th><th class="num">{pipeline ? 'Blocks' : 'Layers'}</th><th class="num">All of them</th></tr></thead>
              <tbody>
                {layerRows.map((r: any) => (
                  <tr><td>{CODE_LABEL[r.code]}</td><td class="num mono">{fmtParams(r.perLayer)}</td><td class="num mono">{r.layers}</td><td class="num mono">{fmtParams(r.total)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {p.id === 'params' && (
          <figure class="pfig">
            <div class="pkey" aria-hidden="true">
              <span><i class="k-total" />all parameters</span>
              {moe && <span><i class="k-active" />run for each token</span>}
            </div>
            <ol class="pbars">
              {bars.map((b) => (
                <li title={b.title}>
                  <span class="plabel">{b.label}{b.sub && <small>{b.sub}</small>}</span>
                  <span class="ptrack">
                    {b.total > 0 && <span class="pbar" style={`width:${pct(b.total)}`}>
                      {moe && <span class="pact" style={`width:${(b.active / b.total) * 100}%`} />}
                    </span>}
                    <span class="pval">
                      {b.total ? fmtParams(b.total) : 'shared'}
                      {b.total > 0 && <small> {share(b.total)}</small>}
                      {moe && b.active !== b.total && <small class="pactv">{fmtParams(b.active)} run per token</small>}
                    </span>
                  </span>
                </li>
              ))}
            </ol>
            <figcaption>
              <p class="psum">
                Sum of the matrices: <b>{fmtParams(pb.total)}</b>{moe && <>, of which <b>{fmtParams(pb.active)}</b> run for each token</>}.{' '}
                {pb.reported.total && (
                  <>Reported: {(() => { const x = value('params_total'); return x.url ? <a href={x.url} title={x.title} rel="noopener">{x.text}</a> : <span title={x.title}>{x.text}</span>; })()}
                  {moe && pb.reported.active && <> total, {(() => { const x = value('params_active'); return x.url ? <a href={x.url} title={x.title} rel="noopener">{x.text}</a> : <span title={x.title}>{x.text}</span>; })()} active</>}.</>
                )}
              </p>
              <p class="pnote">
                Each bar is computed from the sizes in the data (hover for the shapes); it is a derivation, not a reported number. Norms and biases are left out; they are a tiny share.
                {pb.missing.length > 0 && <> Not counted: {pb.missing.join(', ')} (the data doesn’t give their shapes), so the sum is a lower bound.</>}
                {offTotal != null && Math.abs(offTotal) <= 0.03 && <> The sum {Math.abs(offTotal) < 0.0005 ? 'matches the reported total' : `lands within ${Math.abs(offTotal * 100).toFixed(1)}% of the reported total`}{offActive != null && Math.abs(offActive) <= 0.05 ? ' and close to the reported active count' : ''}, which cross-checks the sizes in the data.</>}
                {offTotal != null && Math.abs(offTotal) > 0.03 && <strong class="pwarn"> The sum differs from the reported total by {pctText(offTotal)}: a size in the data may not be the one the model builds.</strong>}
              </p>
            </figcaption>
          </figure>
        )}
      </div>
      );
    })
  }
  <p class="symcap">Where the numbers come from: each size in {m.title}’s diagrams, the symbol the concept notes use for it, and its source (hover or follow the value). {pipeline ? `T is the number of ${unit}s in a sample.` : 'T is the number of tokens in the sequence.'}</p>
  <dl class="symbols">
    {
      symbols.map((s: any) => (
        <div>
          <dt>{s.sym}</dt>
          <dd class="val">{s.url ? <a href={s.url} title={s.title} rel="noopener">{s.text}</a> : <span title={s.title}>{s.text}</span>}</dd>
          <dd class="meaning">{s.meaning}</dd>
        </div>
      ))
    }
  </dl>
  <p class="foot">
    {caption ?? 'Generated from the model data, so it always matches the numbers table.'}{' '}
    {tok?.note && d.notes.has(tok.note) && (
      <>
        Tokenizer: <a href={noteUrl(tok.note)} data-slug={tok.note}>{tok.title}</a>.
      </>
    )}
  </p>
</x-modeloverview>

<script>
  // Restorable (src/scripts/trail.ts): the open tab comes back on return.
  class XModelOverview extends HTMLElement {
    tab = '';
    first = '';
    snapshot() {
      return this.tab && this.tab !== this.first ? { tab: this.tab } : null;
    }
    restore(s: unknown) {
      const st = s as { tab?: string };
      if (st?.tab) this.show(st.tab);
    }
    show(_id: string) {}
    connectedCallback() {
      const cfg = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      this.first = cfg.tabs[0];
      this.show = (id: string) => {
        if (!cfg.tabs.includes(id)) return;
        this.tab = id;
        this.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
        this.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.tab === id)));
      };
      this.querySelector('.tabs')!.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
        if (b) this.show(b.dataset.tab!);
      });
      // Blocks with a "+" badge zoom into their own tab (the block's data-open names it).
      const zoom = (e: Event) => {
        const b = (e.target as Element).closest<SVGElement>('[data-open]');
        if (!b) return;
        e.preventDefault();
        this.show(b.dataset.open!);
        this.querySelector<HTMLElement>(`[data-tab="${b.dataset.open}"]`)?.focus({ preventScroll: true });
      };
      this.addEventListener('click', zoom);
      this.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') zoom(e);
      });
      if (!this.tab) this.tab = this.first;
    }
  }
  customElements.define('x-modeloverview', XModelOverview);
</script>

<style>
  .overview {
    display: block;
    margin: 2rem 0;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.2rem;
  }
  .tabs button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-raised);
  }
  /* Every tab's canvas spans the whole panel, so switching tabs doesn't change the width. */
  .panel :global(figure.arch) {
    margin-top: 0.6rem;
    width: 100%;
  }
  .symcap {
    margin: 0.4rem 0 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .symbols {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.15rem 1rem;
    margin: 0;
    font-size: var(--step--1);
  }
  .symbols div {
    display: grid;
    grid-template-columns: 2.6rem auto;
    column-gap: 0.4rem;
    padding: 0.25rem 0;
    border-top: 1px solid var(--rule-soft);
  }
  .symbols dt {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .symbols dd {
    margin: 0;
  }
  .val {
    font-family: var(--font-mono);
  }
  .val a {
    color: var(--ink);
  }
  .meaning {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .foot {
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .hint {
    margin: 0.5rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .plus {
    display: inline-grid;
    place-items: center;
    width: 1.05em;
    height: 1.05em;
    border: 1.2px solid var(--ink-soft);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.8em;
    line-height: 1;
  }
  .wscroll {
    overflow-x: auto;
    margin: 0.2rem 0 0.4rem;
  }
  .tcap {
    margin: 0 0 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* .prose styles bare tables (display: block, wide padding); these are aligned numeric tables. */
  .overview .wscroll .weights {
    display: table;
    margin: 0;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .overview .wscroll .weights caption {
    text-align: left;
    color: var(--ink-soft);
    padding-bottom: 0.3rem;
  }
  .overview .wscroll .weights th {
    text-align: left;
    font-weight: 500;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
    padding: 0.25rem 0.6rem 0.25rem 0;
    white-space: nowrap;
  }
  .overview .wscroll .weights td {
    padding: 0.3rem 0.6rem 0.3rem 0;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
  .overview .wscroll .weights tfoot td {
    border-bottom: none;
    color: var(--ink-soft);
  }
  .overview .wscroll .weights tfoot tr:first-child td {
    border-top: 1px solid var(--rule);
  }
  .overview .wscroll .weights .num {
    text-align: right;
    padding-right: 0;
    padding-left: 1rem;
    white-space: nowrap;
  }
  .mono {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .overview .wscroll .weights td:first-child {
    min-width: 9.5rem;
