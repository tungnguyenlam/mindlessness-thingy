  .ct .chan {
    border-collapse: separate;
    border-spacing: 4px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    min-width: 28rem;
  }
  .ct .chan th {
    font-weight: 500;
    color: var(--ink-soft);
    padding: 0 0.3rem;
    text-align: center;
  }
  .ct .chan td {
    padding: 0.3rem 0.5rem;
    text-align: center;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-block);
