  }
  .ct .chan tr.pick td:first-child {
    color: var(--ink);
    font-weight: 600;
  }
  .ct .chan tr.gap td {
    border: 0;
    background: transparent;
    padding: 0;
    text-align: left;
    color: var(--ink-faint);
  }
  .ct .chan .tt {
    display: inline-block;
    max-width: 6rem;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: bottom;
  }
  .ct .slider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--step--1);
    margin-bottom: 0.7rem;
    color: var(--ink-soft);
  }
  .ct .slider input {
    flex: 1 1 8rem;
    max-width: 16rem;
  }
  .ct .slider output {
    font-family: var(--font-mono);
    min-width: 1.5rem;
    color: var(--ink);
  }
  .ct .readout {
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
    color: var(--ink);
  }
  .ct .hint,
  .ct .caption {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
