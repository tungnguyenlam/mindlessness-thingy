---
import { getEntry } from 'astro:content';
import { noteUrl } from '../../lib/url';
import { layout } from '../../lib/diagram/geometry.mjs';

type Role = 'activation' | 'weight' | 'cache' | 'route' | 'op';

interface Block {
  id: string;
  label: string;
  /** Second line, usually a tensor shape like "n × d_c". */
  sub?: string;
  role?: Role;
  /** Grid position. Leave both out to let the layout place the block. */
  col?: number;
  row?: number;
  /** Columns spanned, default 1. */
  span?: number;
  /** Slug of the note that explains this block. */
  link?: string;
}
interface Edge {
  from: string;
  to: string;
  label?: string;
  dashed?: boolean;
  /** Route around the left or right of the blocks, for residual connections. */
  side?: 'left' | 'right';
}
interface Group {
  label: string;
  /** Top-left and bottom-right cells, inclusive, as [col, row]. */
  from: [number, number];
  to: [number, number];
}
interface Props {
  title: string;
  blocks: Block[];
  edges?: Edge[];
  groups?: Group[];
  caption?: string;
}

const { title, blocks, edges = [], groups = [], caption } = Astro.props;

// All geometry lives in src/lib/diagram/geometry.mjs, shared with the diagram-geometry check, so
// what the check approves is exactly what renders. Blocks without col/row are placed automatically.
const L = layout({ blocks, edges, groups });
const { width, height } = L;
const boxes = blocks.map((b) => L.boxes.get(b.id)!);
const edgeIndex = new Map(blocks.map((b) => [b.id, true]));
for (const e of edges) {
  for (const id of [e.from, e.to]) {
    if (!edgeIndex.has(id)) throw new Error(`<ArchDiagram title="${title}">: edge refers to unknown block "${id}"`);
  }
}
for (const b of blocks) {
  if (b.link && !(await getEntry('notes', b.link))) throw new Error(`<ArchDiagram title="${title}">: block "${b.id}" links to unknown note "${b.link}"`);
}
// Below this width the SVG scrolls sideways instead of shrinking text past readability (mobile).
const minWidth = Math.round(width * 0.72);

const markerId = `arrow-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class="arch ui">
  <div class="scroll" data-keep-scroll>
    <svg viewBox={`0 0 ${width} ${height}`} width={width} style={`min-width:${minWidth}px`} role="img" aria-labelledby={`${markerId}-t`}>
      <title id={`${markerId}-t`}>{title}</title>
      <defs>
        <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0.8 L7,4 L0,7.2" fill="none" stroke="currentColor" stroke-width="1.3"></path>
        </marker>
      </defs>
      {
        L.groupBoxes.map((g) => (
          <g class="group">
            <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="6" />
            <text x={g.x + g.w - 12} y={g.y + g.h} text-anchor="end" dominant-baseline="middle">
              {g.label}
            </text>
          </g>
        ))
      }
      {
        L.routes.map((r) => {
          const e = r.edge;
          return (
            <g class:list={['edge', { dashed: e.dashed }]}>
              <path d={r.d} marker-end={`url(#${markerId})`} />
              {e.label && (
                <text x={r.lx} y={r.ly} dominant-baseline="middle">
                  {e.label}
                </text>
              )}
            </g>
          );
        })
      }
      {
        boxes.map((b) => {
          const r = b;
          const inner = (
            <g class:list={['block', `role-${b.role ?? 'op'}`]}>
              <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="3" />
              <text x={r.cx} y={b.sub ? r.cy - 7 : r.cy} class="label">
                {b.label}
              </text>
              {b.sub && (
                <text x={r.cx} y={r.cy + 10} class="sub">
                  {b.sub}
                </text>
              )}
            </g>
          );
          return b.link ? (
            <a href={noteUrl(b.link)} data-slug={b.link} class="block-link">
              {inner}
            </a>
          ) : (
            inner
          );
        })
      }
    </svg>
  </div>
  <figcaption>
    <span class="caption">{caption ?? title}</span>
    <span class="legend" aria-hidden="true">
      {
        (['activation', 'weight', 'cache', 'route'] as const)
          .filter((role) => blocks.some((b) => b.role === role))
          .map((role) => (
            <span class:list={['key', `role-${role}`]}>
              <i />
              {{ activation: 'activations', weight: 'weights', cache: 'cached', route: 'routing' }[role]}
            </span>
          ))
      }
    </span>
  </figcaption>
</figure>

<style>
  .arch {
    margin: 2rem 0;
    width: min(100%, calc(var(--measure) + 14rem));
  }
  .scroll {
    overflow-x: auto;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
    /* Faint engineering grid behind the blocks */
    background-image:
      linear-gradient(var(--rule-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px);
    background-size: 23px 23px;
    background-position: -1px -1px;
  }
  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    color: var(--ink-soft);
    font-family: var(--font-ui);
  }
  .group rect {
    fill: none;
    stroke: var(--ink-faint);
    stroke-dasharray: 4 3;
  }
  .group text {
    font-size: 11px;
    fill: var(--ink-soft);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 5px;
  }
  .edge path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }
  .edge.dashed path {
    stroke-dasharray: 4 3;
  }
  .edge text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-soft);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 4px;
  }
  .block rect {
    stroke-width: 1.5;
  }
  .block text {
    text-anchor: middle;
    dominant-baseline: middle;
    fill: var(--ink);
  }
  .block .label {
    font-size: 13px;
    font-weight: 500;
  }
  .block .sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-soft);
  }
  .role-activation rect { fill: var(--role-activation-wash); stroke: var(--role-activation); }
  .role-weight rect { fill: var(--role-weight-wash); stroke: var(--role-weight); }
  .role-cache rect { fill: var(--role-cache-wash); stroke: var(--role-cache); stroke-width: 2.2; }
  .role-route rect { fill: var(--role-route-wash); stroke: var(--role-route); }
  .role-op rect { fill: var(--paper-raised); stroke: var(--role-op); }
  .block-link {
    cursor: pointer;
  }
  .block-link:hover rect,
  .block-link:focus-visible rect {
    stroke-width: 2.6;
  }
  .block-link:hover .label {
    text-decoration: underline;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.2rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .legend {
    display: flex;
    gap: 0.9rem;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .key i {
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid;
    border-radius: 2px;
  }
  .key.role-activation i { background: var(--role-activation-wash); border-color: var(--role-activation); }
  .key.role-weight i { background: var(--role-weight-wash); border-color: var(--role-weight); }
  .key.role-cache i { background: var(--role-cache-wash); border-color: var(--role-cache); }
  .key.role-route i { background: var(--role-route-wash); border-color: var(--role-route); }
</style>
