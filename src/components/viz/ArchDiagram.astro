---
import { getEntry } from 'astro:content';
import { noteUrl } from '../../lib/url';
import { layout } from '../../lib/diagram/geometry.mjs';

type Role = 'activation' | 'weight' | 'cache' | 'route' | 'op';

interface Block {
  id: string;
  label: string;
  /** Second line, usually a tensor shape like "n × d_c". */
  sub?: string;
  role?: Role;
  /** Grid position. Leave both out to let the layout place the block. */
  col?: number;
  row?: number;
  /** Columns spanned, default 1. */
  span?: number;
  /** Slug of the note that explains this block. */
  link?: string;
  /** Id of a view the surrounding component opens on click (a <ModelOverview> tab). Drawn with a
   *  "+" badge; the component handles the click. Takes the place of `link`. */
  open?: string;
}
interface Edge {
  from: string;
  to: string;
  label?: string;
  dashed?: boolean;
  /** Route around the left or right of the blocks, for residual connections. */
  side?: 'left' | 'right';
}
interface Group {
  label: string;
  /** Block ids the group covers (preferred: works with automatic placement)... */
  blocks?: string[];
  /** ...or top-left and bottom-right cells, inclusive, as [col, row]. */
  from?: [number, number];
  to?: [number, number];
}
/** One beat of an animated diagram. Ids are block ids and edges as "from>to". */
interface Frame {
  /** What this beat says, in a few plain words. Shown large under the picture. */
  say: string;
  /** Blocks or edges that appear now and stay. Anything never added, flowed or lit is there from the start. */
  add?: string[];
  /** Edges data runs along now (a dot travels from source to target); they appear too. */
  flow?: string[];
  /** Blocks or edges lit up now (they appear too). */
  hot?: string[];
  /** Blocks or edges that disappear now. */
  hide?: string[];
}
interface Props {
  title: string;
  blocks: Block[];
  edges?: Edge[];
  groups?: Group[];
  caption?: string;
  /** Turns the diagram into an animation that plays its frames in a loop while it is on screen. */
  frames?: Frame[];
}

const { title, blocks, edges = [], groups = [], caption, frames = [] } = Astro.props;

// All geometry lives in src/lib/diagram/geometry.mjs, shared with the diagram-geometry check, so
// what the check approves is exactly what renders. Blocks without col/row are placed automatically.
const L = layout({ blocks, edges, groups });
const { width, height } = L;
const boxes = blocks.map((b) => L.boxes.get(b.id)!);
const edgeIndex = new Map(blocks.map((b) => [b.id, true]));
for (const e of edges) {
  for (const id of [e.from, e.to]) {
    if (!edgeIndex.has(id)) throw new Error(`<ArchDiagram title="${title}">: edge refers to unknown block "${id}"`);
  }
}
for (const b of blocks) {
  if (b.link && !(await getEntry('notes', b.link))) throw new Error(`<ArchDiagram title="${title}">: block "${b.id}" links to unknown note "${b.link}"`);
}
// Below this width the SVG scrolls sideways instead of shrinking text past readability (mobile).
const minWidth = Math.round(width * 0.72);
// Natural size in rem (the root is 17px up to laptop widths), so on big screens the diagram grows
// with the type around it instead of staying a small island in a wide column.
const remWidth = `${+(width / 17).toFixed(3)}rem`;

const markerId = `arrow-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Draw order for the scroll-in reveal (src/scripts/motion.ts): an edge starts once everything
// feeding its source has arrived, so the picture fills in the way data flows through it.
// Depth is the longest chain of solid edges into a block; dashed edges (cache writes, loops) are
// ignored for depth so a decoding loop can't make the order circular.
const depth = new Map(blocks.map((b) => [b.id, 0]));
for (let pass = 0; pass < blocks.length; pass++) {
  let changed = false;
  for (const e of edges) {
    if (e.dashed) continue;
    const d = depth.get(e.from)! + 1;
    if (d > depth.get(e.to)! && d < blocks.length) {
      depth.set(e.to, d);
      changed = true;
    }
  }
  if (!changed) break;
}
const ranks = [...new Set(edges.map((e) => depth.get(e.from)!))].sort((a, b) => a - b);
const drawStep = (e: Edge) => ranks.indexOf(depth.get(e.from)!);

// Frames are resolved here, at build time, into what is visible and lit in each beat, so the
// script only swaps classes. Data that flows in a beat runs in order: an edge leaving a block
// that another flow of the same beat feeds starts after it (`step`).
const ekey = (e: Edge) => `${e.from}>${e.to}`;
const keys = new Set([...blocks.map((b) => b.id), ...edges.map(ekey)]);
for (const [i, f] of frames.entries()) {
  for (const k of [...(f.add ?? []), ...(f.flow ?? []), ...(f.hot ?? []), ...(f.hide ?? [])]) {
    if (!keys.has(k)) throw new Error(`<ArchDiagram title="${title}">: frame ${i + 1} refers to unknown block or edge "${k}"`);
  }
}
const introduced = new Set(frames.flatMap((f) => [...(f.add ?? []), ...(f.flow ?? []), ...(f.hot ?? []), ...(f.flow ?? []).flatMap((k) => k.split('>'))]));
const plan = (() => {
  const on = new Set([...keys].filter((k) => !introduced.has(k)));
  return frames.map((f) => {
    for (const k of [...(f.add ?? []), ...(f.flow ?? []), ...(f.hot ?? [])]) on.add(k);
    for (const k of f.flow ?? []) for (const id of k.split('>')) on.add(id);
    for (const k of f.hide ?? []) on.delete(k);
    const flow = f.flow ?? [];
    const step = new Map(flow.map((k) => [k, 0]));
    for (let pass = 0; pass < flow.length; pass++) {
      for (const k of flow) {
        const from = k.split('>')[0];
        for (const j of flow) if (j.split('>')[1] === from && j !== k) step.set(k, Math.max(step.get(k)!, step.get(j)! + 1));
      }
    }
    // A group box shows once something inside it has appeared.
    L.groupBoxes.forEach((g, gi) => {
      if ((g.blocks ?? []).some((id: string) => on.has(id)) || !(g.blocks ?? []).length) on.add(`group:${gi}`);
    });
    return { say: f.say, on: [...on], hot: [...new Set([...(f.hot ?? []), ...flow])], flow: flow.map((k) => [k, step.get(k)!]) };
  });
})();
const framed = plan.length > 0;
const first = plan[0];
const stateClass = (k: string) => (framed ? { off: !first.on.includes(k), hot: first.hot.includes(k) } : {});
---

<x-frames class:list={['frames-wrap', { framed }]} data-restorable={framed ? '' : undefined} data-frames={framed ? JSON.stringify(plan) : undefined}>
<figure class:list={['arch ui', { framed }]} style={`--w:${remWidth}`} data-draw={framed ? undefined : ''}>
  <div class="scroll" data-keep-scroll>
    <svg viewBox={`0 0 ${width} ${height}`} width={width} style={`width:${remWidth};min-width:${minWidth}px`} role="img" aria-labelledby={`${markerId}-t`}>
      <title id={`${markerId}-t`}>{title}</title>
      <defs>
        <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0.8 L7,4 L0,7.2" fill="none" stroke="currentColor" stroke-width="1.3"></path>
        </marker>
      </defs>
      {
        L.groupBoxes.map((g, gi) => (
          <g class:list={['group', framed && { beat: true, off: !first.on.includes(`group:${gi}`) }]} data-k={framed ? `group:${gi}` : undefined}>
            <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="6" />
            <text x={g.x + g.w - 12} y={g.y + g.h} text-anchor="end" dominant-baseline="middle">
              {g.label}
            </text>
          </g>
        ))
      }
      {
        L.routes.map((r) => {
          const e = r.edge;
          return (
            <g class:list={['edge', e.dashed ? 'dashed' : 'solid', stateClass(ekey(e))]} style={`--i:${drawStep(e)}`} data-k={ekey(e)}>
              <path d={r.d} marker-end={`url(#${markerId})`} pathLength={e.dashed ? undefined : 1} />
              {e.label && (
                <text x={r.lx} y={r.ly} dominant-baseline="middle">
                  {e.label}
                </text>
              )}
            </g>
          );
        })
      }
      {
        boxes.map((b) => {
          const block = (el: any) => (framed ? <g class:list={['beat', stateClass(b.id)]} data-k={b.id}>{el}</g> : el);
          const r = b;
          const inner = (
            <g class:list={['block', `role-${b.role ?? 'op'}`]}>
              <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="3" />
              <text x={r.cx} y={b.sub ? r.cy - 7 : r.cy} class="label">
                {b.label}
              </text>
              {b.sub && (
                <text x={r.cx} y={r.cy + 10} class="sub">
                  {b.sub}
                </text>
              )}
            </g>
          );
          if (b.open)
            return block(
              <g class="block-open" data-open={b.open} role="button" tabindex="0" aria-label={`Open the ${b.label} view`}>
                {inner}
                <g class="badge" aria-hidden="true">
                  <circle cx={r.x + r.w} cy={r.y} r="7" />
                  <path d={`M${r.x + r.w - 3.5},${r.y} h7 M${r.x + r.w},${r.y - 3.5} v7`} />
                </g>
              </g>
            );
          return block(
            b.link ? (
              <a href={noteUrl(b.link)} data-slug={b.link} class="block-link">
                {inner}
              </a>
            ) : (
              inner
            ),
          );
        })
      }
      {
        framed &&
          L.routes.map((r) => (
            <circle class="dot" r="4.5" data-k={ekey(r.edge)} style={`offset-path: path('${r.d}')`} aria-hidden="true" />
          ))
      }
    </svg>
  </div>
  {
    framed && (
      <div class="player">
        <p class="says" aria-live="polite">
          {plan.map((f, i) => (
            <span class="say" hidden={i > 0 ? true : undefined}>{f.say}</span>
          ))}
        </p>
        <div class="controls" hidden>
          <button type="button" class="play" aria-label="Pause">
            <svg viewBox="0 0 12 12" aria-hidden="true"><path class="i-pause" d="M3,2 v8 M9,2 v8" /><path class="i-play" d="M3,1.5 L10,6 L3,10.5 Z" /></svg>
          </button>
          <span class="beats">
            {plan.map((_, i) => (
              <button type="button" class="beat-dot" data-i={i} aria-label={`Frame ${i + 1} of ${plan.length}`} aria-current={i === 0 ? 'step' : undefined} />
            ))}
          </span>
        </div>
      </div>
    )
  }
  <figcaption>
    <span class="caption">{caption ?? title}</span>
    <span class="legend" aria-hidden="true">
      {
        (['activation', 'weight', 'cache', 'route'] as const)
          .filter((role) => blocks.some((b) => b.role === role))
          .map((role) => (
            <span class:list={['key', `role-${role}`]}>
              <i />
              {{ activation: 'activations', weight: 'weights', cache: 'cached', route: 'routing' }[role]}
            </span>
          ))
      }
    </span>
  </figcaption>
</figure>
</x-frames>

<script>
  // An animated diagram (frames={[...]}): plays its frames in a loop while at least half of it is
  // on screen. Clicking the picture or the button pauses; a dot jumps to that frame and pauses.
  // Restorable (src/scripts/trail.ts): a returning reader finds the frame they were on, paused,
  // because restoring never starts motion (src/scripts/motion.ts). Reduced motion never autoplays.
  type Plan = { say: string; on: string[]; hot: string[]; flow: [string, number][] }[];
  const FRAME = 1000 / 30;
  class XFrames extends HTMLElement {
    i = 0;
    started = false;
    paused = false;
    visible = false;
    timer = 0;
    plan: Plan = [];
    show = (_i: number, _animate: boolean) => {};
    snapshot() {
      return this.started ? { f: this.i, p: this.paused } : null;
    }
    restore(state: unknown) {
      const s = state as { f?: number } | null;
      if (!s || typeof s.f !== 'number') return;
      this.started = true;
      this.setPaused(true);
      this.show(s.f, false);
    }
    setPaused(_p: boolean) {}
    connectedCallback() {
      if (!this.dataset.frames) return;
      this.plan = JSON.parse(this.dataset.frames);
      const els = [...this.querySelectorAll<SVGElement>('svg [data-k]')];
      const says = [...this.querySelectorAll<HTMLElement>('.say')];
      const dots = [...this.querySelectorAll<HTMLButtonElement>('.beat-dot')];
      const play = this.querySelector<HTMLButtonElement>('.play')!;
      const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      const words = (s: string) => s.split(/\s+/).length;
      // A beat lasts until its last dot lands, plus time to read what it says.
      const length = (i: number) => {
        const f = this.plan[i];
        const steps = f.flow.length ? Math.max(...f.flow.map(([, s]) => s)) + 1 : 0;
        return Math.max(2200, steps * 16 * FRAME + 900 + words(f.say) * 260);
      };
      this.show = (i, animate) => {
        this.i = (i + this.plan.length) % this.plan.length;
        const f = this.plan[this.i];
        const on = new Set(f.on);
        const hot = new Set(f.hot);
        const flow = new Map(f.flow);
        for (const el of els) {
          const k = el.dataset.k!;
          if (el.classList.contains('dot')) {
            el.classList.remove('go');
            if (animate && flow.has(k) && !reduced()) {
              void el.getBoundingClientRect(); // restart the run
              el.style.setProperty('--s', String(flow.get(k)));
              el.classList.add('go');
            }
            continue;
          }
          el.classList.toggle('off', !on.has(k));
          el.classList.toggle('hot', hot.has(k));
        }
        says.forEach((s, k) => (s.hidden = k !== this.i));
        dots.forEach((d, k) => (k === this.i ? d.setAttribute('aria-current', 'step') : d.removeAttribute('aria-current')));
      };
      const tick = () => {
        clearTimeout(this.timer);
        if (this.paused || !this.visible) return;
        this.timer = window.setTimeout(() => {
          this.show(this.i + 1, true);
          tick();
        }, length(this.i) + (this.i === this.plan.length - 1 ? 1200 : 0));
      };
      this.setPaused = (p: boolean) => {
        this.paused = p;
        this.classList.toggle('paused', p);
        play.setAttribute('aria-label', p ? 'Play' : 'Pause');
        tick();
      };
      this.querySelector<HTMLElement>('.controls')!.hidden = false;
      play.addEventListener('click', () => {
        this.started = true;
        if (this.paused) this.show(this.i + (this.i === this.plan.length - 1 ? 1 : 0), true);
        this.setPaused(!this.paused);
      });
      this.querySelector('svg')!.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a, [data-open]')) return;
        play.click();
      });
      dots.forEach((d, k) =>
        d.addEventListener('click', () => {
          this.started = true;
          this.setPaused(true);
          this.show(k, true);
        }),
      );
      this.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        this.started = true;
        this.setPaused(true);
        this.show(this.i + (e.key === 'ArrowRight' ? 1 : -1), true);
      });
      if (reduced()) this.setPaused(true);
      document.addEventListener('trail:restore', () => {
        if (!this.started) this.setPaused(true);
      });
      new IntersectionObserver(
        ([entry]) => {
          this.visible = entry.isIntersecting;
          if (this.visible && !this.started && !this.paused) {
            this.started = true;
            this.show(0, true);
          }
          tick();
        },
        { threshold: 0.5 },
      ).observe(this.querySelector('svg')!);
    }
  }
  customElements.define('x-frames', XFrames);
</script>

<style>
  x-frames {
    display: block;
  }
  .arch {
    margin: 2rem 0;
    /* At least the usual column, wider when the diagram is: the panel hugs big diagrams. */
    width: min(100%, max(var(--mid), var(--w) + 2px));
  }
  .scroll {
    overflow-x: auto;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
    /* Faint engineering grid behind the blocks */
    background-image:
      linear-gradient(var(--rule-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px);
    background-size: 23px 23px;
    background-position: -1px -1px;
  }
  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    color: var(--ink-soft);
    font-family: var(--font-ui);
  }
  .group rect {
    fill: none;
    stroke: var(--ink-faint);
    stroke-dasharray: 4 3;
  }
  .group text {
    font-size: 11px;
    fill: var(--ink-soft);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 5px;
  }
  .edge path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }
  .edge.dashed path {
    stroke-dasharray: 4 3;
  }
  .edge text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-soft);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 4px;
  }
  .block rect {
    stroke-width: 1.5;
  }
  .block text {
    text-anchor: middle;
    dominant-baseline: middle;
    fill: var(--ink);
  }
  .block .label {
    font-size: 13px;
    font-weight: 500;
  }
  .block .sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-soft);
  }
  .role-activation rect { fill: var(--role-activation-wash); stroke: var(--role-activation); }
  .role-weight rect { fill: var(--role-weight-wash); stroke: var(--role-weight); }
  .role-cache rect { fill: var(--role-cache-wash); stroke: var(--role-cache); stroke-width: 2.2; }
  .role-route rect { fill: var(--role-route-wash); stroke: var(--role-route); }
  .role-op rect { fill: var(--paper-raised); stroke: var(--role-op); }
  .block-link,
  .block-open {
    cursor: pointer;
  }
  .block-open:hover rect,
  .block-open:focus-visible rect {
    stroke-width: 2.6;
  }
  .block-open:focus-visible {
    outline: none;
  }
  .badge circle {
    fill: var(--paper-raised);
    stroke: var(--ink-soft);
    stroke-width: 1.2;
  }
  .badge path {
    stroke: var(--ink-soft);
    stroke-width: 1.4;
    fill: none;
  }
  .block-open:hover .badge circle,
  .block-open:focus-visible .badge circle {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .block-open:hover .badge path,
  .block-open:focus-visible .badge path {
    stroke: var(--paper-raised);
  }
  .block-link:hover rect,
  .block-link:focus-visible rect {
    stroke-width: 2.6;
  }
  .block-link:hover .label {
    text-decoration: underline;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.2rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .legend {
    display: flex;
    gap: 0.9rem;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .key i {
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid;
    border-radius: 2px;
  }
  .key.role-activation i { background: var(--role-activation-wash); border-color: var(--role-activation); }
  .key.role-weight i { background: var(--role-weight-wash); border-color: var(--role-weight); }
  .key.role-cache i { background: var(--role-cache-wash); border-color: var(--role-cache); }
  .key.role-route i { background: var(--role-route-wash); border-color: var(--role-route); }

  /* Animated diagrams: things fade in as they join the story, lit ones stand out, dots carry data. */
  .framed .beat,
  .framed .edge {
    transition: opacity calc(8 * var(--f)) var(--ease-fade);
  }
  .framed .off {
    opacity: 0;
    pointer-events: none;
  }
  .framed .beat.hot .block rect {
    stroke-width: 2.8;
  }
  .framed .beat.hot .block {
    animation: beat-pulse calc(12 * var(--f)) var(--ease-land);
    transform-box: fill-box;
    transform-origin: center;
  }
  .framed .edge.hot path {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .framed .edge:not(.hot):not(.off) {
    opacity: 0.45;
  }
  .dot {
    fill: var(--ink);
    stroke: var(--paper-raised);
    stroke-width: 1.5;
    offset-rotate: 0deg;
    offset-distance: 0%;
    opacity: 0;
    pointer-events: none;
  }
  .dot.go {
    animation: dot-run calc(15 * var(--f)) var(--ease-glide) calc(var(--s, 0) * 16 * var(--f)) both;
  }
  @keyframes dot-run {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @keyframes beat-pulse {
    30% {
      transform: scale(1.05);
    }
  }
  .framed svg {
    cursor: pointer;
  }
  .player {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-top: 0.6rem;
  }
  .says {
    display: grid;
    flex: 1 1 18rem;
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
    font-weight: 500;
  }
  /* Every line shares one cell, so the player is as tall as its longest line and never jumps. */
  .say {
    grid-area: 1 / 1;
  }
  .say[hidden] {
    display: block;
    visibility: hidden;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .controls[hidden] {
    display: none;
  }
  .play {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }
  .play svg {
    width: 0.75rem;
    height: 0.75rem;
    cursor: inherit;
  }
  .play path {
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }
  .play .i-play {
    fill: currentColor;
    stroke: none;
    display: none;
  }
  x-frames.paused .play .i-play {
