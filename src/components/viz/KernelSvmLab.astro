---
// Interactive Kernel Methods & Support Vector Machine lab (src/lib/svmlab.mjs).
// Two views:
//   view="boundary": 2D SVM decision boundary, margin gutters, support vectors, live drag/add points,
//                    kernel selector (linear / poly / rbf), C and gamma sliders.
//   view="lift":     2D input space -> 3D lifted feature space (phi(x)) with interactive 3D orbit
//                    showing a flat hyperplane separating non-linearly-separable classes.
interface Props {
  title: string;
  view?: 'boundary' | 'lift';
  preset?: 'linear' | 'circles' | 'moons' | 'xor';
  kernel?: 'linear' | 'poly' | 'rbf';
  C?: number;
  gamma?: number;
  caption?: string;
}

const {
  title,
  view = 'boundary',
  preset = view === 'lift' ? 'circles' : 'linear',
  kernel = view === 'lift' ? 'poly' : 'linear',
  C = 2,
  gamma = 1.5,
  caption,
} = Astro.props;

const config = JSON.stringify({ view, preset, kernel, C, gamma });
---

<figure class="ksvm-fig">
  <x-kernelsvm class="ksvm ui" data-view={view} data-restorable>
    <script type="application/json" set:html={config} />
    <div class="ksvm-head">
      <p class="ksvm-title">{title}</p>
      <div class="ksvm-presets" role="tablist" aria-label="Dataset preset">
        <button type="button" role="tab" data-preset="linear" aria-selected={preset === 'linear' ? 'true' : 'false'}>Linear</button>
        <button type="button" role="tab" data-preset="circles" aria-selected={preset === 'circles' ? 'true' : 'false'}>Circles</button>
        <button type="button" role="tab" data-preset="moons" aria-selected={preset === 'moons' ? 'true' : 'false'}>Moons</button>
        <button type="button" role="tab" data-preset="xor" aria-selected={preset === 'xor' ? 'true' : 'false'}>XOR</button>
      </div>
    </div>

    {view === 'boundary' ? (
      <div class="ksvm-body">
        <div class="ksvm-stage">
          <div class="ksvm-plot-wrap">
            <canvas class="ksvm-heat" width="180" height="180" aria-hidden="true"></canvas>
            <svg class="ksvm-svg" viewBox="0 0 360 360" role="img" aria-label="2D SVM decision boundary and margin"></svg>
          </div>
          <div class="ksvm-toolbar">
            <div class="ksvm-brush" role="group" aria-label="Click-to-add class">
              <span class="ksvm-lbl">Click plot to add:</span>
              <button type="button" class="ksvm-pill is-pos" data-brush="1" aria-pressed="true">+1</button>
              <button type="button" class="ksvm-pill is-neg" data-brush="-1" aria-pressed="false">-1</button>
            </div>
            <button type="button" class="ksvm-reset" data-action="reset">Reset points</button>
          </div>
        </div>

        <div class="ksvm-side">
          <div class="ksvm-group">
            <span class="ksvm-lbl">Kernel</span>
            <div class="ksvm-segs" role="tablist" aria-label="Kernel function">
              <button type="button" role="tab" data-kernel="linear" aria-selected={kernel === 'linear' ? 'true' : 'false'}>Linear</button>
              <button type="button" role="tab" data-kernel="poly" aria-selected={kernel === 'poly' ? 'true' : 'false'}>Poly (d=2)</button>
              <button type="button" role="tab" data-kernel="rbf" aria-selected={kernel === 'rbf' ? 'true' : 'false'}>RBF</button>
            </div>
          </div>

          <label class="ksvm-slider">
            <span class="ksvm-slider-row">
              <span>Margin penalty <em>C</em></span>
              <output data-for="C">{C}</output>
            </span>
            <input type="range" name="C" min="-1.3" max="2" step="0.05" value={Math.log10(C).toFixed(2)} />
            <span class="ksvm-ends"><span>wide street (soft)</span><span>strict fit (hard)</span></span>
          </label>

          <label class="ksvm-slider" data-gamma-wrap>
            <span class="ksvm-slider-row">
              <span>Kernel width <em>γ</em></span>
              <output data-for="gamma">{gamma}</output>
            </span>
            <input type="range" name="gamma" min="-1" max="1" step="0.05" value={Math.log10(gamma).toFixed(2)} />
            <span class="ksvm-ends"><span>broad / smooth</span><span>tight / local</span></span>
          </label>

          <dl class="ksvm-stats">
            <div><dt>Support vectors</dt><dd data-stat="sv">—</dd></div>
            <div><dt>Margin 2/||w||</dt><dd data-stat="margin">—</dd></div>
            <div><dt>Accuracy</dt><dd data-stat="acc">—</dd></div>
            <div><dt>Inside margin</dt><dd data-stat="viol">—</dd></div>
          </dl>

          <ul class="ksvm-legend">
            <li><i class="dot-pos"></i>class +1</li>
            <li><i class="dot-neg"></i>class -1</li>
            <li><i class="dot-sv"></i>support vector (α &gt; 0)</li>
            <li><i class="line-bound"></i>f(x) = 0</li>
            <li><i class="line-margin"></i>margin f(x) = ±1</li>
          </ul>
          <p class="ksvm-hint">Drag any dot to move it, or click empty space to add a point.</p>
        </div>
      </div>
    ) : (
      <div class="ksvm-body ksvm-body-lift">
        <div class="ksvm-lift-grid">
          <div class="ksvm-panel">
            <p class="ksvm-subhead">1. Input space (2D): curved boundary</p>
            <svg class="ksvm-lift-2d" viewBox="0 0 280 280" role="img" aria-label="2D input space"></svg>
          </div>
          <div class="ksvm-panel">
            <p class="ksvm-subhead">2. Feature space φ(x) (3D): flat plane</p>
            <svg class="ksvm-lift-3d" viewBox="0 0 320 280" role="img" aria-label="3D lifted feature space"></svg>
          </div>
        </div>
        <div class="ksvm-lift-controls">
          <div class="ksvm-segs" role="tablist" aria-label="Feature map">
            <button type="button" role="tab" data-lift="quad" aria-selected="true">Quadratic φ(x) = (x₁², √2 x₁x₂, x₂²)</button>
            <button type="button" role="tab" data-lift="rbf" aria-selected="false">Radial bump (x₁, x₂, exp(-γ||x||²))</button>
          </div>
          <div class="ksvm-orbit-btns">
            <button type="button" data-orbit="side">3D view</button>
            <button type="button" data-orbit="top">Top (2D)</button>
            <span class="ksvm-hint">Drag 3D plot to rotate · hover a dot to link 2D ↔ 3D</span>
          </div>
        </div>
      </div>
    )}
  </x-kernelsvm>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ksvm-fig {
    margin: 1.5rem auto;
    max-width: var(--wide);
  }
  .ksvm-fig figcaption {
    margin-top: 0.55rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .ksvm {
    display: block;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    padding: 0.9rem 1rem 1rem;
    font-family: var(--font-ui);
    color: var(--ink);
  }
  .ksvm-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule-soft);
    margin-bottom: 0.85rem;
  }
  .ksvm-title {
    margin: 0;
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--ink);
  }
  .ksvm-presets,
  .ksvm-segs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    background: var(--paper);
    padding: 0.2rem;
    border-radius: var(--radius-block);
    border: 1px solid var(--rule-soft);
  }
  .ksvm-presets button,
  .ksvm-segs button,
  .ksvm-pill,
  .ksvm-reset,
  .ksvm-orbit-btns button {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-block);
    cursor: pointer;
    line-height: 1.2;
  }
  .ksvm-presets button[aria-selected='true'],
  .ksvm-segs button[aria-selected='true'] {
    background: var(--paper-raised);
    color: var(--ink);
    border-color: var(--rule);
    box-shadow: 0 1px 2px rgba(20, 33, 61, 0.06);
  }
  .ksvm-body {
    display: grid;
    grid-template-columns: minmax(250px, 360px) minmax(220px, 1fr);
    gap: 1rem 1.25rem;
    align-items: start;
  }
  .ksvm-body-lift {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .ksvm-lift-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .ksvm-panel {
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-block);
    padding: 0.5rem;
  }
  .ksvm-subhead {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .ksvm-plot-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-block);
    overflow: hidden;
    touch-action: none;
  }
  .ksvm-heat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .ksvm-svg,
  .ksvm-lift-2d,
  .ksvm-lift-3d {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
  }
  .ksvm-lift-3d {
    cursor: grab;
    touch-action: none;
  }
  .ksvm-lift-3d:active {
    cursor: grabbing;
  }
  .ksvm-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    margin-top: 0.5rem;
  }
  .ksvm-brush {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .ksvm-lbl {
    font-size: 0.78rem;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .ksvm-pill {
    border-color: var(--rule);
    background: var(--paper);
  }
  .ksvm-pill.is-pos[aria-pressed='true'] {
    background: var(--role-activation-wash);
    border-color: var(--role-activation);
    color: var(--role-activation);
    font-weight: 600;
  }
  .ksvm-pill.is-neg[aria-pressed='true'] {
    background: #fbe6dc;
    border-color: var(--series-bias);
    color: var(--series-bias);
    font-weight: 600;
  }
  .ksvm-reset,
  .ksvm-orbit-btns button {
    border-color: var(--rule);
    background: var(--paper);
    color: var(--ink);
  }
  .ksvm-side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ksvm-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .ksvm-slider {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.82rem;
  }
