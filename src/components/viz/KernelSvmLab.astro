  }
  .ksvm-slider-row output {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink);
  }
  .ksvm-slider input[type='range'] {
    width: 100%;
    accent-color: var(--role-activation);
  }
  .ksvm-ends {
