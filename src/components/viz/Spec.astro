---
import { getEntry } from 'astro:content';

interface Row {
  label: string;
  /** One value. Use `values` instead when the table has `columns`. */
  value?: string | number;
  /** One value per column after the first, in order. */
  values?: (string | number)[];
  /** Source id from src/content/sources/. Required: no unsourced numbers. */
  source: string;
  /** Where in the source, e.g. "§2.1", "Table 1", "config.json: kv_lora_rank". */
  where?: string;
}
interface Props {
  title: string;
  rows: Row[];
  /**
   * Column headings, the row-label column first: ['Steps T', 'Success', 'Latency (ms)'].
   * Without it the table has one Field and one Value column. Never pack several
   * numbers into one value string; give each its own column.
   */
  columns?: string[];
  /** One or two sentences under the table: what to look at, symbols, footnote marks. */
  note?: string;
}

const { title, rows, columns, note } = Astro.props;
const heads = columns ?? ['Field', 'Value'];
const resolved = await Promise.all(
  rows.map(async (r) => {
    if (!r.source) throw new Error(`<Spec title="${title}">: row "${r.label}" has no source`);
    const cells = columns ? r.values : [r.value];
    if (!cells || cells.length !== heads.length - 1 || cells.some((c) => c === undefined))
      throw new Error(`<Spec title="${title}">: row "${r.label}" needs ${heads.length - 1} value(s) to match its columns`);
    const src = await getEntry('sources', r.source);
    if (!src) throw new Error(`<Spec title="${title}">: row "${r.label}" cites unknown source "${r.source}"`);
    return { ...r, cells, src };
  }),
);
// A multi-column table whose rows all cite the same place names it once, under the table.
const first = resolved[0];
const shared = columns && resolved.every((r) => r.source === first.source && r.where === first.where) ? first : null;
---

<figure class:list={['spec', 'ui', { multi: columns }]}>
  <table>
    <caption>{title}</caption>
    <thead>
      <tr>{heads.map((h) => <th scope="col">{h}</th>)}{!shared && <th scope="col">Source</th>}</tr>
    </thead>
    <tbody>
      {
        resolved.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.cells.map((c) => <td class="value">{c}</td>)}
            {!shared && <td class="src">
              <a href={r.src.data.url} title={r.src.data.title} rel="noopener">
                {r.src.data.short}
              </a>
              {r.where && <span class="where">{r.where}</span>}
            </td>}
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    (note || shared) && (
      <figcaption class="note">
        {note}
        {shared && (
          <span class="src">
            {note && ' '}Source:{' '}
            <a href={shared.src.data.url} title={shared.src.data.title} rel="noopener">{shared.src.data.short}</a>
            {shared.where && `, ${shared.where}`}.
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .spec {
    margin: 2rem 0;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  caption {
    text-align: left;
    font-weight: 600;
    font-size: var(--step-0);
    padding-bottom: 0.5rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.4rem 0.8rem 0.4rem 0;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: baseline;
  }
  thead th {
    font-weight: 500;
    color: var(--ink-soft);
    border-bottom-color: var(--rule);
  }
  tbody th {
    font-weight: 500;
  }
  .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .multi thead th {
    vertical-align: bottom;
  }
  .multi tbody th {
    white-space: nowrap;
  }
  .multi .value {
    text-align: right;
  }
  .multi thead th:not(:first-child, :last-child) {
    text-align: right;
  }
  .src {
    color: var(--ink-soft);
  }
  .note {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .where {
    margin-left: 0.4rem;
    color: var(--ink-faint);
  }
</style>
