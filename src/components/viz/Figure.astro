---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="figure">
  <slot />
  <figcaption class="ui">{caption}</figcaption>
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }
  .figure :global(img),
  .figure :global(svg) {
    max-width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
