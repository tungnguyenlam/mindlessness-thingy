---
interface Input {
  id: string;
  label: string;
  min: number;
  max: number;
  step?: number;
  value: number;
  unit?: string;
}
interface Output {
  label: string;
  /** JavaScript expression over the input ids, e.g. "2 * layers * heads * head_dim". */
  expr: string;
  format?: 'number' | 'bytes' | 'percent' | 'ratio';
  role?: 'activation' | 'weight' | 'cache' | 'route' | 'op';
}
interface Props {
  title: string;
  inputs: Input[];
  outputs: Output[];
  /** Draw the outputs as bars on a shared scale. */
  bars?: boolean;
  note?: string;
}

const { title, inputs, outputs, bars = false, note } = Astro.props;
const ids = inputs.map((i) => i.id);
for (const o of outputs) {
  try {
    new Function(...ids, `return (${o.expr});`);
  } catch (e) {
    throw new Error(`<Calc title="${title}">: output "${o.label}" has an invalid expression: ${(e as Error).message}`);
  }
}
const config = JSON.stringify({ inputs, outputs, bars });
---

<x-calc class="calc ui" data-restorable>
  <script type="application/json" set:html={config} />
  <p class="title">{title}</p>
  <div class="inputs">
    {
      inputs.map((i) => (
        <label>
          <span class="name">{i.label}</span>
          <input type="range" name={i.id} min={i.min} max={i.max} step={i.step ?? 1} value={i.value} />
          <output for={i.id} data-input={i.id}>
            {i.value}
            {i.unit ? ` ${i.unit}` : ''}
          </output>
        </label>
      ))
    }
  </div>
  <dl class="outputs">
    {
      outputs.map((o, k) => (
        <div class:list={['row', `role-${o.role ?? 'op'}`]}>
          <dt>{o.label}</dt>
          <dd>
            {bars && !['ratio', 'percent'].includes(o.format ?? '') && (
              <span class="bar">
                <span data-bar={k} />
              </span>
            )}
            <span class="value" data-out={k}>
              …
            </span>
          </dd>
        </div>
      ))
    }
  </dl>
  {note && <p class="note">{note}</p>}
</x-calc>

<script>
  type Fmt = 'number' | 'bytes' | 'percent' | 'ratio';
  const fmt = (v: number, f: Fmt = 'number') => {
    if (!Number.isFinite(v)) return '—';
    if (f === 'percent') return `${(v * 100).toFixed(1)}%`;
    if (f === 'ratio') return `${v.toFixed(v < 10 ? 2 : 1)}×`;
    if (f === 'bytes') {
      const u = ['B', 'KB', 'MB', 'GB', 'TB'];
      let i = 0;
      while (Math.abs(v) >= 1024 && i < u.length - 1) (v /= 1024), i++;
      return `${v.toFixed(v < 10 && i ? 2 : v < 100 && i ? 1 : 0)} ${u[i]}`;
    }
    return Math.abs(v) >= 1e4 ? v.toLocaleString('en-US', { maximumFractionDigits: 0 }) : String(+v.toPrecision(4));
  };

  // Restorable (src/scripts/trail.ts): returning to this page puts the sliders back where the reader left them.
  class XCalc extends HTMLElement {
    ranges: HTMLInputElement[] = [];
    update = () => {};
    snapshot() {
      const moved = this.ranges.filter((r) => r.value !== r.defaultValue);
      return moved.length ? Object.fromEntries(moved.map((r) => [r.name, r.value])) : null;
    }
    restore(state: unknown) {
      if (!state || typeof state !== 'object') return;
      for (const r of this.ranges) {
        const v = (state as Record<string, string>)[r.name];
        if (v !== undefined) r.value = v;
      }
      this.update();
    }
    connectedCallback() {
      const cfg = JSON.parse(this.querySelector('script[type="application/json"]')!.textContent!);
      const ids: string[] = cfg.inputs.map((i: { id: string }) => i.id);
      const fns = cfg.outputs.map((o: { expr: string }) => new Function(...ids, `return (${o.expr});`));
      const ranges = (this.ranges = [...this.querySelectorAll<HTMLInputElement>('input[type="range"]')]);
      const update = (this.update = () => {
        const vals = ranges.map((r) => Number(r.value));
        ranges.forEach((r, k) => {
          const unit = cfg.inputs[k].unit;
          this.querySelector(`[data-input="${r.name}"]`)!.textContent = `${fmt(vals[k])}${unit ? ` ${unit}` : ''}`;
        });
        const outs: number[] = fns.map((f: (...a: number[]) => number) => f(...vals));
        const scaled = (k: number) => !['ratio', 'percent'].includes(cfg.outputs[k].format);
        const max = Math.max(...outs.filter((v, k) => scaled(k) && Number.isFinite(v)));
        outs.forEach((v: number, k: number) => {
          this.querySelector(`[data-out="${k}"]`)!.textContent = fmt(v, cfg.outputs[k].format);
          const bar = this.querySelector<HTMLElement>(`[data-bar="${k}"]`);
          if (bar) bar.style.width = `${max > 0 ? Math.max(0.5, (v / max) * 100) : 0}%`;
        });
      });
      ranges.forEach((r) => r.addEventListener('input', update));
      update();
    }
  }
  customElements.define('x-calc', XCalc);
</script>

<style>
  .calc {
    display: block;
    margin: 2rem 0;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    font-size: var(--step--1);
  }
  .title {
    margin: 0 0 0.8rem;
    font-weight: 600;
    font-size: var(--step-0);
  }
  .inputs {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  label {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) 1fr 6.5rem;
    align-items: center;
    gap: 0.8rem;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--ink);
  }
  output {
    font-family: var(--font-mono);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .outputs {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--rule-soft);
    padding-top: 0.8rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) 1fr;
    gap: 0.8rem;
    align-items: center;
  }
  dt {
    font-weight: 500;
  }
  dd {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem;
  }
  .bar {
    flex: 1;
    height: 0.7rem;
    background: var(--rule-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--role-op);
    transition: width 120ms ease-out;
  }
  .role-activation .bar span { background: var(--role-activation); }
  .role-weight .bar span { background: var(--role-weight); }
  .role-cache .bar span { background: var(--role-cache); }
  .role-route .bar span { background: var(--role-route); }
  .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    min-width: 6.5rem;
    text-align: right;
  }
  .note {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
  }
  @media (max-width: 560px) {
    label,
    .row {
      grid-template-columns: 1fr auto;
    }
    label input {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
