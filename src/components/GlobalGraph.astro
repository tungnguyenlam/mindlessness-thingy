---
import { url } from '../lib/url';
---

<x-graph class="global-graph ui" data-src={url('/graph.json')} data-base={url('')} data-restorable>
  <div class="graph-bar">
    <div class="graph-filters" role="group" aria-label="Filter map by note kind">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="concept" aria-pressed="false">Concepts</button>
      <button type="button" data-filter="system" aria-pressed="false">Systems</button>
    </div>
    <div class="graph-actions">
      <p class="hint">Drag to move, scroll to zoom, click a node to open it.</p>
      <button type="button" class="fit-btn" disabled>Reset view</button>
    </div>
  </div>
  <div class="graph-stage">
    <svg role="img" aria-label="Map of every note and how they link"></svg>
  </div>
  <div class="legend" aria-hidden="true">
    <span><svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="4.2" /></svg>Concept</span>
    <span><svg viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" /></svg>System</span>
    <span><svg viewBox="0 0 12 12"><circle class="filled" cx="6" cy="6" r="4.2" /></svg>Verified</span>
    <span><svg viewBox="0 0 12 12"><circle class="stub" cx="6" cy="6" r="4.2" /></svg>Stub</span>
    <span><svg viewBox="0 0 24 12"><path class="line" d="M1 6 H23" /></svg>Read first</span>
    <span><svg viewBox="0 0 24 12"><path class="line weak" d="M1 6 H23" /></svg>Mentions</span>
  </div>
</x-graph>

<script>
  import {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCollide,
    forceX,
    forceY,
    type SimulationNodeDatum,
  } from 'd3-force';

  interface N extends SimulationNodeDatum {
    slug: string;
    title: string;
    kind: string;
    status: string;
  }
  interface E {
    source: N | string;
    target: N | string;
    type: string;
  }

  const SVG = 'http://www.w3.org/2000/svg';
  const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}) => {
    const e = document.createElementNS(SVG, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  };
  const strong = new Set(['prerequisite', 'builds_on', 'step']);

  // Restorable (src/scripts/trail.ts): coming back to the map keeps the reader's pan, zoom, and
  // kind filter, and whenReady() tells the trail when node links exist so it can mark the one clicked.
  type FilterKind = 'all' | 'concept' | 'system';

  class XGraph extends HTMLElement {
    view: { get(): unknown; set(s: unknown): void } | null = null;
    pending: unknown = null;
    markReady = () => {};
    ready = new Promise<void>((r) => (this.markReady = r));
    snapshot() {
      return this.view?.get() ?? null;
    }
    restore(state: unknown) {
      if (this.view) this.view.set(state);
      else this.pending = state;
    }
    whenReady() {
      return this.ready;
    }
    async connectedCallback() {
      const svg = this.querySelector<SVGSVGElement>('.graph-stage > svg')!;
      const fitBtn = this.querySelector<HTMLButtonElement>('.fit-btn')!;
      const filterBtns = [...this.querySelectorAll<HTMLButtonElement>('.graph-filters button')];
      const base = this.dataset.base!;
      const data = (await (await fetch(this.dataset.src!)).json()) as {
        nodes: N[];
        edges: { from: string; to: string; type: string }[];
      };
      // Paths link to every step and would turn the map into a hub; they're listed below the map instead.
      const nodes = data.nodes.filter((n) => n.kind !== 'path');
      const keep = new Set(nodes.map((n) => n.slug));
      const edges = data.edges.filter((e) => keep.has(e.from) && keep.has(e.to));
      const w = () => svg.clientWidth || 800;
      const h = () => svg.clientHeight || 480;

      // Depth in the read-first graph: foundations at 0, each note one below its deepest prerequisite.
      const prereqs = new Map<string, string[]>(nodes.map((n) => [n.slug, []]));
      for (const e of edges) if (e.type === 'prerequisite' || e.type === 'builds_on') prereqs.get(e.from)!.push(e.to);
      const depth = new Map<string, number>();
      const depthOf = (s: string, seen = new Set<string>()): number => {
        if (depth.has(s)) return depth.get(s)!;
        if (seen.has(s)) return 0;
        seen.add(s);
        const d = Math.max(-1, ...prereqs.get(s)!.map((p) => depthOf(p, seen))) + 1;
        depth.set(s, d);
        return d;
      };
      nodes.forEach((n) => depthOf(n.slug));
      const ROW = 78;

      // Draw prerequisite edges in learning direction: from the thing you read first.
      const links: E[] = edges.map((e) =>
        e.type === 'prerequisite' || e.type === 'builds_on'
          ? { source: e.to, target: e.from, type: e.type }
          : { source: e.from, target: e.to, type: e.type },
      );
      // Notes not linked to the main web (a new topic with its own few notes) would be pushed to the
      // far edge by the charge force and shrink the whole map, so they get a firmer pull to the centre.
      const group = new Map<string, number>();
      const nbrs = new Map<string, string[]>(nodes.map((n) => [n.slug, []]));
      for (const e of edges) nbrs.get(e.from)!.push(e.to), nbrs.get(e.to)!.push(e.from);
      for (const n of nodes) {
        if (group.has(n.slug)) continue;
        const stack = [n.slug];
        group.set(n.slug, group.size);
        const id = group.get(n.slug)!;
        while (stack.length) for (const t of nbrs.get(stack.pop()!)!) if (!group.has(t)) group.set(t, id), stack.push(t);
      }
      const sizes = new Map<number, number>();
      for (const id of group.values()) sizes.set(id, (sizes.get(id) ?? 0) + 1);
      const main = [...sizes].sort((a, b) => b[1] - a[1])[0]?.[0];
      const degree = new Map<string, number>();
      for (const e of edges) for (const s of [e.from, e.to]) degree.set(s, (degree.get(s) ?? 0) + 1);

      const defs = el('defs');
      const marker = el('marker', {
        id: 'g-arrow',
        viewBox: '0 0 8 8',
        refX: 15,
        refY: 4,
        markerWidth: 6,
        markerHeight: 6,
        orient: 'auto',
      });
      marker.append(el('path', { d: 'M0,0.8 L7,4 L0,7.2', class: 'arrow' }));
      defs.append(marker);
      const world = el('g', { class: 'world' });
      const linkLayer = el('g', { class: 'links' });
      const nodeLayer = el('g', { class: 'nodes' });
      world.append(linkLayer, nodeLayer);
      svg.append(defs, world);

      const lineEls = links.map((l) => {
        const isStrong = strong.has(l.type);
        const line = el('line', { class: isStrong ? 'line strong' : 'line weak' });
        if (isStrong) line.setAttribute('marker-end', 'url(#g-arrow)');
        linkLayer.append(line);
        return line;
      });

      const radius = (n: N) => 4.5 + Math.min(5, Math.sqrt(degree.get(n.slug) ?? 0) * 1.4);
      const nodeEls = nodes.map((n) => {
        const a = el('a', {
          href: `${base}/notes/${n.slug}/`,
          'data-slug': n.slug,
          class: `node kind-${n.kind} status-${n.status}`,
        });
        const r = radius(n);
        const hit = el('circle', { r: Math.max(13, r + 5), class: 'hit' });
        const shape =
          n.kind === 'system'
            ? el('rect', { x: -r, y: -r, width: r * 2, height: r * 2, rx: 1.2 })
            : n.kind === 'path'
              ? el('path', { d: `M0 ${-r * 1.3} L${r * 1.3} 0 L0 ${r * 1.3} L${-r * 1.3} 0 Z` })
              : el('circle', { r });
        const label = el('text', { x: r + 4, y: 3.5 });
        label.textContent = n.title;
        a.append(hit, shape, label);
        nodeLayer.append(a);
        return a;
      });

      nodes.forEach((n, i) => {
        n.y = depth.get(n.slug)! * ROW;
        n.x = (i % 7) * 60;
      });
      const sim = forceSimulation<N>(nodes)
        .force(
          'link',
          forceLink<N, any>(links)
            .id((d) => d.slug)
            .distance((l) => (strong.has(l.type) ? 72 : 124))
            .strength((l) => (strong.has(l.type) ? 0.3 : 0.03)),
        )
        .force('charge', forceManyBody().strength(-420))
        .force(
          'collide',
          forceCollide<N>().radius((d) => radius(d) + 22),
        )
        .force(
          'x',
          forceX(0).strength((d) => (group.get((d as N).slug) === main ? 0.015 : 0.12)),
        )
        .force(
          'y',
          forceY<N>((d) => depth.get(d.slug)! * ROW).strength(0.9),
        );

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        sim.stop();
        sim.tick(300);
      } else {
        // Pre-tick so the map opens already organised instead of exploding from a grid.
        sim.tick(70);
        sim.alpha(0.35);
      }

      let userMoved = false;
      let sx = 1;
      let k = 1;
      let tx = 0;
      let ty = 0;
      let activeFilter: FilterKind = 'all';

      const setUserMoved = (moved: boolean) => {
        userMoved = moved;
        fitBtn.disabled = !moved;
      };

      const apply = () => world.setAttribute('transform', `translate(${tx},${ty}) scale(${k})`);

      const fit = () => {
        const xs = nodes.map((n) => n.x!);
        const ys = nodes.map((n) => n.y!);
        const vw = w();
        const vh = h();
        const pad = vw < 520 ? 14 : 24;
        const labelRoom = vw < 520 ? 84 : 150;
        const xMin = Math.min(...xs);
        const xMax = Math.max(...xs);
        const y0 = Math.min(...ys) - 18;
        const y1 = Math.max(...ys) + 18;
        const spanY = Math.max(1, y1 - y0);
        const spanX = Math.max(1, xMax - xMin);
        const wantK = Math.min(1.25, (vw - pad * 2) / (spanX + labelRoom));
        k = Math.min(wantK, (vh - pad * 2) / spanY);
        sx = Math.max(1, Math.min(2.2, ((vw - pad * 2) / k - labelRoom) / spanX));
        const x0 = xMin * sx - 12;
        const x1 = xMax * sx + labelRoom;
        tx = (vw - (x1 - x0) * k) / 2 - x0 * k;
        ty = (vh - spanY * k) / 2 - y0 * k;
        apply();
      };

      const draw = () => {
        if (!userMoved) fit();
        links.forEach((l, i) => {
          const s = l.source as N;
          const t = l.target as N;
          lineEls[i].setAttribute('x1', String(s.x! * sx));
          lineEls[i].setAttribute('y1', String(s.y));
          lineEls[i].setAttribute('x2', String(t.x! * sx));
          lineEls[i].setAttribute('y2', String(t.y));
        });
        nodes.forEach((n, i) => nodeEls[i].setAttribute('transform', `translate(${n.x! * sx},${n.y})`));
      };
      sim.on('tick', draw);

      // Hover / focus: fade everything that isn't a direct neighbour.
      const adj = new Map<string, Set<string>>(nodes.map((n) => [n.slug, new Set([n.slug])]));
      for (const l of links) {
        const s = (l.source as N).slug;
        const t = (l.target as N).slug;
        adj.get(s)!.add(t);
        adj.get(t)!.add(s);
      }
      const focus = (slug: string | null) => {
        svg.classList.toggle('focusing', !!slug);
        const near = slug ? adj.get(slug)! : null;
        nodes.forEach((n, i) => {
          nodeEls[i].classList.toggle('near', !!near?.has(n.slug));
          nodeEls[i].classList.toggle('hovered', n.slug === slug);
        });
        links.forEach((l, i) =>
          lineEls[i].classList.toggle(
            'near',
            !!slug && ((l.source as N).slug === slug || (l.target as N).slug === slug),
          ),
        );
      };
      nodeEls.forEach((a, i) => {
        a.addEventListener('mouseenter', () => focus(nodes[i].slug));
        a.addEventListener('focus', () => focus(nodes[i].slug));
        a.addEventListener('mouseleave', () => focus(null));
        a.addEventListener('blur', () => focus(null));
      });

      const applyFilter = (kind: FilterKind) => {
        activeFilter = kind;
        svg.classList.toggle('filtered', kind !== 'all');
        for (const btn of filterBtns) {
          btn.setAttribute('aria-pressed', String(btn.dataset.filter === kind));
        }
        nodes.forEach((n, i) => {
          const match = kind === 'all' || n.kind === kind;
          nodeEls[i].classList.toggle('dimmed', !match);
        });
        links.forEach((l, i) => {
          const s = l.source as N;
          const t = l.target as N;
          const match = kind === 'all' || (s.kind === kind && t.kind === kind);
          lineEls[i].classList.toggle('dimmed', !match);
        });
      };

      for (const btn of filterBtns) {
        btn.addEventListener('click', () => {
          applyFilter((btn.dataset.filter as FilterKind) ?? 'all');
        });
      }

      fitBtn.addEventListener('click', () => {
        setUserMoved(false);
        fit();
        draw();
      });

      draw();

      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(() => {
          if (!userMoved) {
            fit();
            draw();
          }
        });
        ro.observe(svg);
      }

      this.view = {
        get: () => {
          if (!userMoved && activeFilter === 'all') return null;
          return {
            view: userMoved ? { k, tx, ty, sx } : null,
            filter: activeFilter,
          };
        },
        set: (s) => {
          const raw = s as
            | { view?: { k?: number; tx?: number; ty?: number; sx?: number } | null; filter?: FilterKind; k?: number; tx?: number; ty?: number; sx?: number }
            | null;
          if (!raw) return;
          const v = 'view' in raw ? raw.view : raw;
          if (v && typeof v.k === 'number') {
            ({ k, tx = 0, ty = 0, sx = 1 } = v as { k: number; tx: number; ty: number; sx: number });
            setUserMoved(true);
            apply();
            draw();
          }
          if ('filter' in raw && raw.filter) {
            applyFilter(raw.filter);
          }
        },
      };
      if (this.pending) this.view.set(this.pending);
      this.markReady();

      svg.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          setUserMoved(true);
          const r = svg.getBoundingClientRect();
          const mx = e.clientX - r.left;
          const my = e.clientY - r.top;
          const nk = Math.min(4, Math.max(0.25, k * Math.exp(-e.deltaY * 0.0015)));
          tx = mx - ((mx - tx) * nk) / k;
          ty = my - ((my - ty) * nk) / k;
          k = nk;
          apply();
        },
        { passive: false },
      );

      let drag: { node?: N; x: number; y: number; moved: boolean } | null = null;
      const toWorld = (e: PointerEvent) => {
        const r = svg.getBoundingClientRect();
        return [(e.clientX - r.left - tx) / k, (e.clientY - r.top - ty) / k];
      };
      svg.addEventListener('pointerdown', (e) => {
        const a = (e.target as Element).closest('a.node');
        const node = a ? nodes[nodeEls.indexOf(a as SVGAElement)] : undefined;
        drag = { node, x: e.clientX, y: e.clientY, moved: false };
      });
      svg.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const dx = e.clientX - drag.x;
        const dy = e.clientY - drag.y;
        if (!drag.moved && Math.hypot(dx, dy) < 4) return;
        // Capture only once it's a real drag, so a plain click still reaches the link.
        if (!drag.moved) svg.setPointerCapture(e.pointerId);
        drag.moved = true;
        if (drag.node) {
          const [x, y] = toWorld(e);
          drag.node.fx = x / sx;
          drag.node.fy = y;
          sim.alphaTarget(0.2).restart();
        } else {
          setUserMoved(true);
          tx += dx;
          ty += dy;
          drag.x = e.clientX;
          drag.y = e.clientY;
          apply();
        }
      });
      const end = () => {
        if (drag?.node) {
          drag.node.fx = null;
          drag.node.fy = null;
          sim.alphaTarget(0);
        }
        setTimeout(() => (drag = null));
      };
      svg.addEventListener('pointerup', end);
      svg.addEventListener('pointercancel', end);
      svg.addEventListener(
        'click',
        (e) => {
          if (drag?.moved) e.preventDefault();
        },
        true,
      );
    }
  }
  customElements.define('x-graph', XGraph);
</script>

<style>
  .global-graph {
    display: block;
    position: relative;
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    background: var(--paper-raised);
    overflow: hidden;
  }
  .graph-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--paper);
  }
  .graph-filters {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: 5px;
    padding: 0.15rem;
  }
  .graph-filters button {
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    border-radius: 3px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
    transition:
      background-color calc(4 * var(--f)) var(--ease-fade),
      color calc(4 * var(--f)) var(--ease-fade);
  }
  .graph-filters button:hover {
    color: var(--ink);
  }
  .graph-filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper-raised);
    font-weight: 500;
  }
  .graph-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .fit-btn {
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
    transition:
      opacity calc(4 * var(--f)) var(--ease-fade),
      border-color calc(4 * var(--f)) var(--ease-fade);
  }
  .fit-btn:hover:not(:disabled) {
    border-color: var(--ink-soft);
  }
  .fit-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .graph-stage {
    position: relative;
  }
  .graph-stage > svg {
    display: block;
    width: 100%;
    height: clamp(440px, 62vh, 660px);
    touch-action: none;
    cursor: grab;
  }
  .graph-stage > svg:active {
    cursor: grabbing;
  }
  .global-graph :global(.line) {
    stroke: var(--ink-soft);
    stroke-width: 1;
    transition:
      opacity calc(5 * var(--f)) var(--ease-fade),
      stroke calc(5 * var(--f)) var(--ease-fade);
  }
  .global-graph :global(.line.weak) {
    stroke: var(--rule);
    stroke-opacity: 0.6;
    stroke-dasharray: 3 3;
  }
  .global-graph :global(.arrow) {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.2;
  }
  .global-graph :global(.node) {
    transition: opacity calc(5 * var(--f)) var(--ease-fade);
  }
  .global-graph :global(.node .hit) {
    fill: transparent;
    stroke: none;
  }
  .global-graph :global(.node circle:not(.hit)),
  .global-graph :global(.node rect),
  .global-graph :global(.node path) {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
    transition:
      stroke calc(5 * var(--f)) var(--ease-fade),
      fill calc(5 * var(--f)) var(--ease-fade),
      stroke-width calc(5 * var(--f)) var(--ease-fade);
  }
  .global-graph :global(.node.status-verified :is(circle, rect, path)) {
    fill: var(--ink);
  }
  .global-graph :global(.node.status-reviewed :is(circle, rect, path)) {
    fill: var(--rule);
  }
  .global-graph :global(.node.status-stub :is(circle, rect, path)) {
    stroke: var(--ink-faint);
    stroke-dasharray: 2 1.6;
  }
  .global-graph :global(.node text) {
    font-size: 11px;
    fill: var(--ink-soft);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 3px;
    pointer-events: none;
    transition: fill calc(5 * var(--f)) var(--ease-fade);
  }
  .global-graph :global(.node.status-stub text) {
    fill: var(--ink-faint);
  }

  /* Filter & focus states */
  .global-graph :global(svg.filtered .node.dimmed),
  .global-graph :global(svg.filtered .line.dimmed) {
    opacity: 0.12;
  }
  .global-graph :global(svg.filtered .node.dimmed) {
    pointer-events: none;
  }
  .global-graph :global(svg.focusing .node:not(.near)),
  .global-graph :global(svg.focusing .line:not(.near)) {
    opacity: 0.14;
  }
  .global-graph :global(svg.focusing .node.near text) {
    fill: var(--ink);
  }
  .global-graph :global(svg.focusing .node.hovered.kind-concept :is(circle, path)) {
    stroke: var(--role-activation);
    stroke-width: 2.2;
  }
  .global-graph :global(svg.focusing .node.hovered.kind-system rect) {
    stroke: var(--role-cache);
    stroke-width: 2.2;
  }
  .global-graph :global(svg.focusing .line.near.strong) {
    stroke: var(--role-activation);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    animation: graph-flow 0.9s linear infinite;
  }
  .global-graph :global(svg.focusing .line.near.weak) {
    stroke: var(--ink-soft);
    stroke-opacity: 0.85;
  }
  @keyframes graph-flow {
    from {
      stroke-dashoffset: 18;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid var(--rule-soft);
    background: var(--paper);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .legend svg {
    height: 0.75rem;
    width: auto;
  }
  .legend svg * {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .legend svg .filled {
    fill: var(--ink);
  }
  .legend svg .stub {
    stroke: var(--ink-faint);
    stroke-dasharray: 2 1.6;
  }
  .legend svg .line {
    fill: none;
