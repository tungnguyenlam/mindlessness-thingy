---
import Base from '../layouts/Base.astro';
import GlobalGraph from '../components/GlobalGraph.astro';
import NoteIndex from '../components/NoteIndex.astro';
import StatusMark from '../components/StatusMark.astro';
import { getGraph } from '../lib/graph';
import { noteUrl } from '../lib/url';

const g = await getGraph();
const all = [...g.notes.values()];
const paths = all.filter((n) => n.data.kind === 'path');
const conceptsCount = all.filter((n) => n.data.kind === 'concept').length;
const systemsCount = all.filter((n) => n.data.kind === 'system').length;
const written = all.filter((n) => n.data.status !== 'stub').length;
const pct = Math.round((written / Math.max(1, all.length)) * 100);
const recent = all
  .filter((n) => n.data.status !== 'stub')
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 6);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const domainMap = new Map<string, typeof all>();
for (const n of all) {
  if (n.data.kind === 'path' || n.data.status === 'stub') continue;
  for (const dom of n.data.domains) {
    if (!domainMap.has(dom)) domainMap.set(dom, []);
    domainMap.get(dom)!.push(n);
  }
}
const domains = [...domainMap.entries()]
  .filter(([, list]) => list.length >= 3)
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 6)
  .map(([name, list]) => ({
    name,
    count: list.length,
    notes: list.sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()).slice(0, 5),
  }));
---

<Base wide>
  <div class="home">
    <section class="map" aria-labelledby="map-title">
      <header class="hero">
        <div class="hero-copy">
          <h1 id="map-title" class="ui">How the pieces of modern models connect</h1>
          <p class="lede">
            Every circle is one idea, every square is a model built from them. Foundations sit at the top, and arrows run
            down to whatever builds on them.
          </p>
        </div>
        <aside class="pulse ui" aria-label="Notebook status">
          <div class="pulse-top">
            <strong>{written} of {all.length} notes written</strong>
            <span>{pct}%</span>
          </div>
          <div class="pulse-bar" aria-hidden="true">
            <span style={`width: ${pct}%`}></span>
          </div>
          <div class="pulse-counts">
            <span>{conceptsCount} concepts</span>
            <span>{systemsCount} systems</span>
            <span>{paths.length} paths</span>
          </div>
        </aside>
      </header>
      <GlobalGraph />
    </section>

    <div class="below">
      <section class="paths" aria-labelledby="paths-title">
        <h2 id="paths-title" class="ui">Start with a path</h2>
        <ul class="path-list">
          {
            paths.map((p) => {
              const steps = p.data.steps.map((s) => g.notes.get(s)!);
              const done = steps.filter((s) => s.data.status !== 'stub').length;
              return (
                <li class="path-card">
                  <div class="path-head">
                    <a href={noteUrl(p.id)} data-slug={p.id} class="path-title ui">
                      {p.data.title}
                    </a>
                    <span class="path-count ui">
                      {done}/{steps.length}
                    </span>
                  </div>
                  <p>{p.data.summary}</p>
                  <ol class="track ui" aria-label={`${done} of ${steps.length} steps written`}>
                    {steps.map((s) => (
                      <li class={s.data.status === 'stub' ? 'is-stub' : undefined}>
                        <a href={noteUrl(s.id)} data-slug={s.id} title={s.data.title}>
                          <StatusMark status={s.data.status} kind={s.data.kind} size={12} />
                        </a>
                      </li>
                    ))}
                  </ol>
                </li>
              );
            })
          }
        </ul>

        <h2 class="ui">Recently updated</h2>
        <ul class="recent ui">
          {
            recent.map((n) => (
              <li>
                <a href={noteUrl(n.id)} data-slug={n.id}>
                  <StatusMark status={n.data.status} kind={n.data.kind} />
                  <span class="recent-title">{n.data.title}</span>
                  <time datetime={n.data.updated.toISOString().slice(0, 10)}>{fmtDate(n.data.updated)}</time>
                </a>
              </li>
            ))
          }
        </ul>

        {
          domains.length > 0 && (
            <>
              <h2 class="ui">Browse by topic</h2>
              <div class="domain-grid">
                {domains.map((d) => (
                  <div class="domain-card">
                    <div class="domain-head ui">
                      <h3>{d.name}</h3>
                      <span>{d.count}</span>
                    </div>
                    <ul class="ui">
                      {d.notes.map((n) => (
                        <li>
                          <a href={noteUrl(n.id)} data-slug={n.id}>
                            <StatusMark status={n.data.status} kind={n.data.kind} />
                            <span>{n.data.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </>
          )
        }
      </section>

      <section class="index" aria-label="All notes" data-keep-scroll>
        <NoteIndex />
      </section>
    </div>
  </div>
</Base>

<style>
  .home {
    max-width: 160rem;
    margin: 0 auto;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    align-items: end;
    gap: 1rem 2rem;
    margin: 0.25rem 0 1.2rem;
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 0.4rem;
  }
  .lede {
    max-width: var(--measure);
    color: var(--ink-soft);
    margin: 0;
  }
  .pulse {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    padding: 0.7rem 0.9rem;
    font-size: var(--step--1);
  }
  .pulse-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .pulse-top strong {
    font-weight: 600;
  }
  .pulse-top span {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .pulse-bar {
    height: 4px;
    border-radius: 2px;
    background: var(--rule-soft);
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .pulse-bar span {
    display: block;
    height: 100%;
    background: var(--role-activation);
    border-radius: 2px;
  }
  .pulse-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    color: var(--ink-soft);
  }
  .below {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 20vw, 25rem);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: 2.25rem;
  }
  .index {
    position: sticky;
    top: 1.25rem;
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
    padding-right: 0.35rem;
  }
  h2 {
    font-size: var(--step-1);
    font-weight: 600;
    margin: 0 0 0.85rem;
  }
  h2:not(:first-child) {
    margin-top: 2.5rem;
  }
  .path-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 25rem), 1fr));
    gap: 0.9rem;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.15rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    transition: border-color calc(5 * var(--f)) var(--ease-fade);
  }
  .path-card:hover {
    border-color: var(--ink-faint);
  }
  .path-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .path-title {
    font-weight: 600;
    font-size: var(--step-1);
    text-decoration: none;
    line-height: 1.25;
  }
  .path-title:hover {
    text-decoration: underline;
  }
  .path-count {
    flex: none;
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .paths p {
    margin: 0.35rem 0 0.85rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: auto 0 0;
  }
  .track li {
    display: flex;
    align-items: center;
  }
  .track li + li::before {
    content: '';
    width: 0.95rem;
    height: 1px;
    background: var(--ink-soft);
  }
  .track li.is-stub::before {
    background: none;
    border-top: 1px dashed var(--ink-faint);
  }
  .track a {
    display: flex;
    padding: 0.22rem;
    border-radius: 3px;
    transition: transform calc(4 * var(--f)) var(--ease-snap);
  }
  .track a:hover {
    transform: scale(1.35);
  }
  .recent {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0.45rem 1.25rem;
    font-size: var(--step--1);
  }
  .recent a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
    text-decoration: none;
    transition: border-color calc(5 * var(--f)) var(--ease-fade);
  }
  .recent a:hover {
    border-color: var(--ink-faint);
  }
  .recent-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .recent time {
    flex: none;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 0.9rem;
  }
  .domain-card {
    padding: 0.85rem 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-panel);
  }
  .domain-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule-soft);
  }
  .domain-head h3 {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .domain-head span {
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .domain-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }
  .domain-card a {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.18rem 0;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .domain-card a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .hero,
    .below {
      grid-template-columns: minmax(0, 1fr);
    }
    .index {
      position: static;
      max-height: none;
      overflow-y: visible;
      padding-right: 0;
    }
  }
</style>
